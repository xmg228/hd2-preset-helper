import { CandidateGroupRole, PreviewRole, PreviewRow, PreviewSection } from "models.slint";

// Shared labels remain bindings, so changing the language updates every use.
export global UiText {
    out property <string> booster-scan-hint: @tr("For clearer icons, scan Boosters when none are in use.");
    public pure function candidate-group-label(role: CandidateGroupRole) -> string {
        if (role == CandidateGroupRole.offensive) { return @tr("Offensive"); }
        if (role == CandidateGroupRole.supply) { return @tr("Supply"); }
        if (role == CandidateGroupRole.defensive) { return @tr("Defensive"); }
        return "";
    }
    public pure function preset-title(label: string, number: string) -> string {
        return label != "" ? label : @tr("Preset {}", number);
    }
    public pure function folder-title(label: string, number: string) -> string {
        return label != "" ? label : @tr("Folder {}", number);
    }
    public pure function section-message(section: PreviewSection) -> string {
        return section.saved ? section.error : @tr("Not saved");
    }
    public pure function item-label(item: PreviewRow) -> string {
        if (item.role == PreviewRole.stratagem) { return @tr("Stratagem {}", item.number); }
        return root.role-label(item.role);
    }
    public pure function role-label(role: PreviewRole) -> string {
        if (role == PreviewRole.stratagem) { return @tr("Stratagems"); }
        if (role == PreviewRole.booster) { return @tr("Booster"); }
        if (role == PreviewRole.fallback-booster) { return @tr("Fallback Booster"); }
        if (role == PreviewRole.helmet) { return @tr("Helmet"); }
        if (role == PreviewRole.armor) { return @tr("Armor"); }
        if (role == PreviewRole.cape) { return @tr("Cape"); }
        if (role == PreviewRole.primary) { return @tr("Primary"); }
        if (role == PreviewRole.secondary) { return @tr("Secondary"); }
        return @tr("Throwable");
    }
}
