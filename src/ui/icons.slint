export component DragHandle inherits Rectangle {
    in property <color> stroke;
    width: 18px;
    height: 16px;
    for column in 2: Rectangle {
        x: 6px + column * 4px;
        width: 2px;
        height: 16px;
        for row in 3: Rectangle {
            y: 3px + row * 4px;
            width: 2px;
            height: 2px;
            border-radius: 1px;
            background: root.stroke;
        }
    }
}

export component Icon inherits Rectangle {
    in property <string> icon;
    in property <color> stroke;
    in property <length> size: 16px;
    width: size;
    height: size;
    Path {
        x: 0px;
        y: 0px;
        width: 16px;
        height: 16px;
        fit: preserve;
        commands: root.icon;
        fill: transparent;
        stroke: root.stroke;
        stroke-width: 1.5px;
        stroke-line-cap: round;
        stroke-line-join: round;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.size / 16px;
    }
}
