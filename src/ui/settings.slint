import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";
import { IconButton, PanelButton, PanelComboBox, SettingToggle } from "controls.slint";
import { BindingRow, ShortcutEditor } from "shortcuts.slint";
import { ShortcutRow } from "models.slint";
import { UpdateView, UpdatePhase } from "updates.slint";
import { UiText } from "text.slint";

export enum SettingsPage { general, shortcuts, item-cache, preset-shortcut, about, licenses }
export enum SettingToggleKey {
    apply-in-saved-order, auto-ready-up, save-fallback-when-taken, keep-panel-open,
    always-on-top, start-with-windows, check-updates-automatically
}

export component SettingsDialog inherits Rectangle {
    in property <bool> enabled;
    in property <[ShortcutRow]> rows;
    in property <[string]> monitor-labels;
    in property <int> selected-monitor;
    in property <int> selected-language;
    in property <[string]> language-fonts;
    in property <bool> keep-panel-open;
    in property <bool> always-on-top;
    in property <bool> startup-available;
    in property <bool> start-with-windows;
    in property <bool> apply-in-saved-order;
    in property <bool> auto-ready-up;
    in property <bool> save-fallback-when-taken;
    in property <bool> check-updates-automatically;
    in property <UpdatePhase> update-phase;
    in property <string> current-version;
    in property <string> update-version;
    in property <string> update-error;
    in property <float> update-download-fraction;
    in property <string> update-download-size;
    in property <bool> update-install-allowed;
    in-out property <int> recording: -1;
    in property <string> error;
    in property <int> shortcut-error-index: -1;
    in property <string> shortcut-warning;
    in property <bool> saving;
    in property <int> shortcut-index: -1;
    private property <SettingsPage> page: SettingsPage.general;
    private property <bool> shortcut-only: page == SettingsPage.preset-shortcut;
    private property <string> notices;
    private property <int> scan-kind;
    private property <bool> focus-scan-on-open;
    private property <int> migration-kind: 0;
    private property <[string]> item-kinds: [@tr("All items"), @tr("Stratagems"), @tr("Booster"),
        @tr("Helmet"), @tr("Armor"), @tr("Cape"),
        @tr("Primary"), @tr("Secondary"), @tr("Throwable")];
    out property <bool> viewing-licenses: page == SettingsPage.licenses;
    callback record(int);
    callback clear(int);
    callback change-toggle(SettingToggleKey, bool);
    callback change-language(int);
    callback change-monitor(int);
    callback close();
    callback check-updates();
    callback view-update-notes();
    callback download-update();
    callback install-update();
    callback view-project();
    callback view-quick-start();
    callback scan-items(int);
    callback inspect-migration(int);
    callback license-text() -> string;
    forward-focus: keys;
    public function focus-dialog(page: SettingsPage) {
        root.page = root.shortcut-index > 0 ? SettingsPage.preset-shortcut
            : page == SettingsPage.general && root.shortcut-warning != "" ? SettingsPage.shortcuts : page;
        root.scan-kind = 0;
        root.notices = "";
        keys.focus();
        root.focus-scan-on-open = root.page == SettingsPage.item-cache;
    }
    background: Theme.surface;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;
    TouchArea { }
    keys := FocusScope {
        enabled: root.enabled;
        capture-key-pressed(event) => {
            return !root.enabled || root.saving ? accept : reject;
        }
        capture-key-released(event) => {
            return !root.enabled || root.saving ? accept : reject;
        }
        key-pressed(event) => {
            if (event.text == Key.Escape && !root.saving) {
                if (root.recording >= 0) { root.recording = -1; }
                else if (root.viewing-licenses) { root.page = SettingsPage.about; keys.focus(); }
                else { root.close(); }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            HorizontalLayout {
                height: 30px;
                Text {
                    text: root.shortcut-only ? @tr("Set shortcut") : @tr("Settings");
                    color: Theme.text;
                    font-size: 21px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                IconButton {
                    label: @tr("Close");
                    icon: Icons.close;
                    cross-axis-self-alignment: center;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.close(); }
                }
            }
            if (!root.shortcut-only): HorizontalLayout {
                height: 32px;
                alignment: start;
                spacing: 8px;
                PanelButton {
                    min-width: 100px; text: @tr("General"); filled: root.page == SettingsPage.general;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.recording = -1; root.page = SettingsPage.general; }
                }
                PanelButton {
                    min-width: 100px; text: @tr("Shortcuts"); filled: root.page == SettingsPage.shortcuts;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.page = SettingsPage.shortcuts; }
                }
                PanelButton {
                    min-width: 100px; text: @tr("Item cache"); filled: root.page == SettingsPage.item-cache;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.recording = -1; root.page = SettingsPage.item-cache; }
                }
                PanelButton {
                    min-width: 100px; text: @tr("About");
                    filled: root.page == SettingsPage.about || root.viewing-licenses;
                    enabled: root.enabled && !root.saving;
                    clicked => {
                        root.recording = -1;
                        root.page = SettingsPage.about;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if (root.shortcut-only): VerticalLayout {
                spacing: 12px;
                Text { text: @tr("Click a shortcut to record. Esc cancels."); color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
                BindingRow {
                    item: root.rows[root.shortcut-index];
                    recording: root.recording == root.shortcut-index;
                    error: root.shortcut-error-index == root.shortcut-index ? root.error : "";
                    enabled: root.enabled && !root.saving;
                    record => { root.record(root.shortcut-index); }
                    clear => { keys.focus(); root.clear(root.shortcut-index); }
                }
            }
            if (root.page == SettingsPage.general): ScrollView {
                content-width: self.visible-width - 8px;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    SettingToggle {
                        text: @tr("Apply Stratagems in saved order");
                        description: @tr("Only when all four slots start empty.");
                        checked: root.apply-in-saved-order;
                        toggle(value) => { root.change-toggle(SettingToggleKey.apply-in-saved-order, value); }
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Auto ready up");
                        description: @tr("Ready up after successfully applying a Booster.");
                        checked: root.auto-ready-up;
                        toggle(value) => { root.change-toggle(SettingToggleKey.auto-ready-up, value); }
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Remember a fallback Booster");
                        description: @tr("Remembers your replacement when saved Boosters are taken.");
                        checked: root.save-fallback-when-taken;
                        toggle(value) => { root.change-toggle(SettingToggleKey.save-fallback-when-taken, value); }
                        enabled: root.enabled && !root.saving;
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Language"); color: Theme.text; font-size: 14px; }
                        PanelComboBox {
                            model: [@tr("Follow system"), "English", "简体中文", "繁體中文",
                                "日本語", "한국어", "Deutsch", "Français", "Italiano",
                                "Español (España)", "Español (Latinoamérica)",
                                "Português (Brasil)", "Português (Portugal)", "Polski", "Русский"];
                            current-index: root.selected-language;
                            choose(index) => { root.change-language(index); }
                            font-families: root.language-fonts;
                            wheel-select: false;
                            enabled: root.enabled && !root.saving;
                        }
                        Text { text: @tr("Display language for the interface."); color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Status window"); color: Theme.text; font-size: 14px; }
                        PanelComboBox {
                            model: root.monitor-labels;
                            current-index: root.selected-monitor;
                            choose(index) => { root.change-monitor(index); }
                            wheel-select: false;
                            enabled: root.enabled && !root.saving;
                        }
                        Text { text: @tr("Screen for the status window."); color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
                    }
                    SettingToggle {
                        text: @tr("Keep panel open");
                        description: @tr("Stays visible when you switch windows or run an action.");
                        checked: root.keep-panel-open;
                        toggle(value) => { root.change-toggle(SettingToggleKey.keep-panel-open, value); }
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Always on top");
                        description: @tr("Keeps the panel above other windows.");
                        checked: root.always-on-top;
                        toggle(value) => { root.change-toggle(SettingToggleKey.always-on-top, value); }
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Start with Windows");
                        description: @tr("Starts in the background after sign-in.");
                        checked: root.start-with-windows;
                        toggle(value) => { root.change-toggle(SettingToggleKey.start-with-windows, value); }
                        enabled: root.enabled && !root.saving && root.startup-available;
                    }
                }
            }
            if (root.page == SettingsPage.item-cache): ScrollView {
                private property <bool> scan-focus-requested: root.focus-scan-on-open;
                function focus-scan-if-requested() {
                    if (self.scan-focus-requested) {
                        scan-button.focus();
                        root.focus-scan-on-open = false;
                    }
                }
                init => { self.focus-scan-if-requested(); }
                changed scan-focus-requested => { self.focus-scan-if-requested(); }
                content-width: self.visible-width - 8px;
                VerticalLayout {
                    alignment: start;
                    spacing: 10px;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Scan item lists"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text {
                            text: @tr("Updates item lists from the game for editing and applying presets. Equipment scans also generate thumbnails.");
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PanelComboBox {
                                model: root.item-kinds;
                                current-index <=> root.scan-kind;
                                enabled: root.enabled && !root.saving;
                            }
                            scan-button := PanelButton {
                                text: @tr("Scan");
                                filled: true;
                                enabled: root.enabled && !root.saving;
                                clicked => { root.scan-items(root.scan-kind); }
                            }
                        }
                        Text {
                            text: UiText.booster-scan-hint;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Migrate presets"); color: Theme.text; font-size: 14px; font-weight: 600; }
                        Text {
                            text: @tr("Refresh saved preset images after a game language change or Stratagem icon update.");
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            PanelComboBox {
                                model: root.item-kinds;
                                current-index <=> root.migration-kind;
                                enabled: root.enabled && !root.saving;
                            }
                            PanelButton {
                                text: @tr("Check presets");
                                filled: true;
                                height: 32px;
                                enabled: root.enabled && !root.saving;
                                clicked => { root.inspect-migration(root.migration-kind); }
                            }
                        }
                        Text {
                            text: @tr("Requires complete caches from a previous scan of the selected item types, with no changes to available items.");
                            color: Theme.text-secondary;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }
                }
            }
            if (root.page == SettingsPage.about): ScrollView {
                content-width: self.visible-width - 8px;
                VerticalLayout {
                    alignment: start;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 36px;
                        padding-left: 8px;
                        Text {
                            text: "HD2 Preset Helper";
                            color: Theme.text; font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    UpdateView {
                        check-automatically: root.check-updates-automatically;
                        change-check-automatically(value) => { root.change-toggle(SettingToggleKey.check-updates-automatically, value); }
                        enabled: root.enabled && !root.saving;
                        install-allowed: root.update-install-allowed;
                        phase: root.update-phase;
                        current-version: root.current-version;
                        available-version: root.update-version;
                        error: root.update-error;
                        download-fraction: root.update-download-fraction;
                        download-size: root.update-download-size;
                        check => { root.check-updates(); }
                        notes => { root.view-update-notes(); }
                        download => { root.download-update(); }
                        install => { root.install-update(); }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding: 8px;
                        height: 48px;
                        alignment: center;
                        spacing: 8px;
                        PanelButton {
                            text: "GitHub";
                            enabled: root.enabled && !root.saving;
                            clicked => { root.view-project(); }
                        }
                        PanelButton {
                            text: @tr("Quick start");
                            enabled: root.enabled && !root.saving;
                            clicked => { root.view-quick-start(); }
                        }
                        PanelButton {
                            text: @tr("Open-source licenses");
                            enabled: root.enabled && !root.saving;
                            clicked => {
                                if (root.notices == "") { root.notices = root.license-text(); }
                                root.page = SettingsPage.licenses;
                                keys.focus();
                            }
                        }
                    }
                }
            }
            if (root.page == SettingsPage.shortcuts): ShortcutEditor {
                rows: root.rows;
                recording: root.recording;
                error: root.error;
                error-index: root.shortcut-error-index;
                enabled: root.enabled && !root.saving;
                record(index) => { root.record(index); }
                clear(index) => { keys.focus(); root.clear(index); }
            }
            if root.viewing-licenses: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    IconButton {
                        label: @tr("Back");
                        icon: Icons.back;
                        enabled: root.enabled;
                        clicked => { root.page = SettingsPage.about; keys.focus(); }
                    }
                    Text {
                        text: @tr("Open-source licenses");
                        color: Theme.text-secondary; font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                TextEdit {
                    text: root.notices;
                    read-only: true;
                    enabled: root.enabled;
                    font-size: 12px;
                }
            }
            if (root.page == SettingsPage.shortcuts && root.shortcut-warning != "" && root.error == ""): Text {
                text: @tr("Currently unavailable:\n") + root.shortcut-warning;
                color: Theme.warning;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("\{parent.text}"); }
            }
            if (root.error != "" && root.shortcut-error-index < 0): Text {
                text: root.error;
                color: #e9b3a0;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("\{root.error}"); }
            }
        }
    }
}
