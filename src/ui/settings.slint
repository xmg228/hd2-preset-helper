import { Theme } from "theme.slint";
import { ScrollView, TextEdit } from "std-widgets.slint";
import { IconButton, PanelButton, PanelComboBox, SettingToggle } from "controls.slint";
import { ShortcutEditor } from "shortcuts.slint";
import { ShortcutRow } from "models.slint";
import { UpdateView, UpdatePhase } from "updates.slint";

enum SettingsPage { general, shortcuts, about, licenses }

export component SettingsDialog inherits Rectangle {
    in property <bool> enabled;
    in property <[ShortcutRow]> rows;
    in property <[string]> monitor-labels;
    in-out property <int> selected-monitor;
    in-out property <int> selected-language;
    in property <[string]> language-fonts;
    in-out property <bool> apply-in-saved-order;
    in-out property <bool> auto-ready-up;
    in-out property <bool> save-fallback-when-taken;
    in-out property <bool> check-updates-automatically;
    in property <UpdatePhase> update-phase;
    in property <string> current-version;
    in property <string> update-version;
    in property <string> update-error;
    in property <bool> update-install-allowed;
    in-out property <int> recording: -1;
    in property <string> error;
    in property <string> shortcut-warning;
    in property <bool> saving;
    private property <SettingsPage> page: SettingsPage.general;
    private property <string> notices;
    out property <bool> viewing-licenses: page == SettingsPage.licenses;
    callback clear(int);
    callback save();
    callback cancel();
    callback check-updates();
    callback view-update-notes();
    callback install-update();
    callback view-project();
    callback license-text() -> string;
    forward-focus: keys;
    public function focus-dialog(show-about: bool) {
        root.page = show-about ? SettingsPage.about
            : root.shortcut-warning == "" ? SettingsPage.general : SettingsPage.shortcuts;
        root.notices = "";
        keys.focus();
    }
    background: Theme.surface;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;
    TouchArea { }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Escape && !root.saving) {
                if (root.recording >= 0) { root.recording = -1; }
                else if (root.viewing-licenses) { root.page = SettingsPage.about; keys.focus(); }
                else { root.cancel(); }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text { text: @tr("Settings"); color: Theme.text; font-size: 21px; height: 30px; }
            HorizontalLayout {
                height: 32px;
                alignment: start;
                spacing: 8px;
                PanelButton {
                    min-width: 100px; text: @tr("General"); filled: root.page == SettingsPage.general;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.recording = -1; root.page = SettingsPage.general; }
                }
                PanelButton {
                    min-width: 100px; text: @tr("Shortcuts"); filled: root.page == SettingsPage.shortcuts;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.page = SettingsPage.shortcuts; }
                }
                PanelButton {
                    min-width: 100px; text: @tr("About");
                    filled: root.page == SettingsPage.about || root.viewing-licenses;
                    enabled: root.enabled && !root.saving;
                    clicked => {
                        root.recording = -1;
                        root.page = SettingsPage.about;
                    }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if (root.page == SettingsPage.general): ScrollView {
                content-width: self.visible-width - 8px;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    SettingToggle {
                        text: @tr("Apply Stratagems in saved order");
                        description: @tr("Only when all four slots start empty.");
                        checked <=> root.apply-in-saved-order;
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Auto ready up");
                        description: @tr("Ready up after successfully applying a Booster.");
                        checked <=> root.auto-ready-up;
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Save fallback Booster when taken");
                        description: @tr("Wait for your selection, then save it as a fallback.");
                        checked <=> root.save-fallback-when-taken;
                        enabled: root.enabled && !root.saving;
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Language"); color: Theme.text; font-size: 14px; }
                        PanelComboBox {
                            model: [@tr("Follow system"), "English", "简体中文", "繁體中文",
                                "日本語", "한국어", "Deutsch", "Français", "Italiano",
                                "Español (España)", "Español (Latinoamérica)",
                                "Português (Brasil)", "Português (Portugal)", "Polski", "Русский"];
                            current-index <=> root.selected-language;
                            font-families: root.language-fonts;
                            enabled: root.enabled && !root.saving;
                        }
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Display"); color: Theme.text; font-size: 14px; }
                        PanelComboBox {
                            model: root.monitor-labels;
                            current-index <=> root.selected-monitor;
                            enabled: root.enabled && !root.saving;
                        }
                        Text { text: @tr("Used for the panel and action status."); color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
            if (root.page == SettingsPage.about): ScrollView {
                content-width: self.visible-width - 8px;
                VerticalLayout {
                    alignment: start;
                    spacing: 12px;
                    HorizontalLayout {
                        height: 36px;
                        padding-left: 8px;
                        Text {
                            text: "HD2 Preset Helper";
                            color: Theme.text; font-size: 18px;
                            vertical-alignment: center;
                        }
                    }
                    UpdateView {
                        check-automatically <=> root.check-updates-automatically;
                        enabled: root.enabled && !root.saving;
                        install-allowed: root.update-install-allowed;
                        phase: root.update-phase;
                        current-version: root.current-version;
                        available-version: root.update-version;
                        error: root.update-error;
                        check => { root.check-updates(); }
                        notes => { root.view-update-notes(); }
                        install => { root.install-update(); }
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    HorizontalLayout {
                        padding: 8px;
                        height: 48px;
                        alignment: center;
                        spacing: 8px;
                        PanelButton {
                            text: "GitHub";
                            enabled: root.enabled && !root.saving;
                            clicked => { root.view-project(); }
                        }
                        PanelButton {
                            text: @tr("Open-source licenses");
                            enabled: root.enabled && !root.saving;
                            clicked => {
                                if (root.notices == "") { root.notices = root.license-text(); }
                                root.page = SettingsPage.licenses;
                                keys.focus();
                            }
                        }
                    }
                }
            }
            if (root.page == SettingsPage.shortcuts): ShortcutEditor {
                rows: root.rows;
                recording <=> root.recording;
                enabled: root.enabled && !root.saving;
                clear(index) => { keys.focus(); root.clear(index); }
            }
            if root.viewing-licenses: VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    height: 28px;
                    spacing: 8px;
                    IconButton {
                        label: @tr("Back");
                        path: "M 19 12 H 5 M 12 5 L 5 12 L 12 19";
                        enabled: root.enabled;
                        clicked => { root.page = SettingsPage.about; keys.focus(); }
                    }
                    Text {
                        text: @tr("Open-source licenses");
                        color: Theme.text-secondary; font-size: 12px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }
                TextEdit {
                    text: root.notices;
                    read-only: true;
                    enabled: root.enabled;
                    font-size: 12px;
                }
            }
            if (root.page == SettingsPage.shortcuts && root.shortcut-warning != "" && root.error == ""): Text {
                text: @tr("Currently unavailable:\n") + root.shortcut-warning;
                color: Theme.warning;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("\{parent.text}"); }
            }
            if (root.error != ""): Text {
                text: root.error;
                color: #e9b3a0;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("\{root.error}"); }
            }
            Rectangle { height: 1px; background: Theme.border; }
            HorizontalLayout {
                height: 32px;
                alignment: end;
                spacing: 10px;
                PanelButton { min-width: 86px; text: @tr("Cancel"); filled: true; enabled: root.enabled && !root.saving; clicked => { root.cancel(); } }
                PanelButton { min-width: 86px; text: root.saving ? @tr("Saving…") : @tr("Save"); accent: true; enabled: root.enabled && !root.saving && root.recording < 0; clicked => { keys.focus(); root.save(); } }
            }
        }
    }
}
