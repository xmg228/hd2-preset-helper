import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PanelButton, PanelComboBox } from "controls.slint";
import { ShortcutEditor } from "shortcuts.slint";
import { ShortcutRow } from "models.slint";

component SettingToggle inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in property <bool> enabled;
    in-out property <bool> checked;
    min-height: 64px;
    vertical-stretch: 0;
    border-radius: 4px;
    border-width: keys.has-focus ? 1px : 0px;
    border-color: Theme.accent-soft;
    background: touch.has-hover && enabled ? Theme.control : transparent;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; } }
    forward-focus: keys;
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 4px;
            Text { text: root.text; color: Theme.text; font-size: 14px; wrap: word-wrap; }
            Text { text: root.description; color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
        }
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.checked ? Theme.accent-soft : Theme.inactive;
            background: root.checked ? Theme.accent-soft : transparent;
            if root.checked: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M 4 9 L 7.5 12.5 L 14 5.5";
                fill: transparent;
                stroke: Theme.background;
                stroke-width: 2px;
            }
        }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (!event.repeat) { root.checked = !root.checked; }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.checked = !root.checked; }
    }
}

export component SettingsDialog inherits Rectangle {
    in property <bool> enabled;
    in property <[ShortcutRow]> rows;
    in property <[string]> monitor-labels;
    in-out property <int> selected-monitor;
    in-out property <int> selected-language;
    in-out property <bool> apply-in-saved-order;
    in-out property <bool> auto-ready-up;
    in-out property <bool> save-fallback-when-taken;
    in-out property <int> recording: -1;
    in property <string> error;
    in property <string> shortcut-warning;
    in property <bool> saving;
    private property <bool> general: true;
    callback clear(int);
    callback save();
    callback cancel();
    public function focus-dialog() { root.general = root.shortcut-warning == ""; keys.focus(); }
    background: Theme.surface;
    border-color: Theme.border-strong;
    border-width: 1px;
    border-radius: 8px;
    TouchArea { }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Escape && !root.saving) {
                if (root.recording >= 0) { root.recording = -1; } else { root.cancel(); }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text { text: @tr("Settings"); color: Theme.text; font-size: 21px; height: 30px; }
            HorizontalLayout {
                height: 32px;
                alignment: start;
                spacing: 8px;
                PanelButton {
                    min-width: 100px; text: @tr("General"); filled: root.general;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.recording = -1; root.general = true; }
                }
                PanelButton {
                    min-width: 100px; text: @tr("Shortcuts"); filled: !root.general;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.general = false; }
                }
            }
            Rectangle { height: 1px; background: Theme.border; }
            if root.general: ScrollView {
                content-width: self.visible-width - 8px;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    SettingToggle {
                        text: @tr("Apply Stratagems in saved order");
                        description: @tr("Only when all four slots start empty.");
                        checked <=> root.apply-in-saved-order;
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Auto ready up");
                        description: @tr("Ready up after successfully applying a Booster.");
                        checked <=> root.auto-ready-up;
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: @tr("Save fallback Booster when taken");
                        description: @tr("Wait for your selection, then save it as a fallback.");
                        checked <=> root.save-fallback-when-taken;
                        enabled: root.enabled && !root.saving;
                    }
                    Rectangle { height: 1px; background: Theme.border; }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Language"); color: Theme.text; font-size: 14px; }
                        PanelComboBox {
                            model: [@tr("Follow system"), "English", "简体中文", "繁體中文",
                                "日本語", "한국어", "Deutsch", "Français", "Italiano",
                                "Español (España)", "Español (Latinoamérica)",
                                "Português (Brasil)", "Português (Portugal)", "Polski", "Русский"];
                            current-index <=> root.selected-language;
                            enabled: root.enabled && !root.saving;
                        }
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: @tr("Display"); color: Theme.text; font-size: 14px; }
                        PanelComboBox {
                            model: root.monitor-labels;
                            current-index <=> root.selected-monitor;
                            enabled: root.enabled && !root.saving;
                        }
                        Text { text: @tr("Used for the panel and action status."); color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
            if !root.general: ShortcutEditor {
                rows: root.rows;
                recording <=> root.recording;
                enabled: root.enabled && !root.saving;
                clear(index) => { root.clear(index); }
            }
            if (!root.general && root.shortcut-warning != "" && root.error == ""): Text {
                text: @tr("Currently unavailable:\n") + root.shortcut-warning;
                color: Theme.warning;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("\{parent.text}"); }
            }
            if (root.error != ""): Text {
                text: root.error;
                color: #e9b3a0;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("\{root.error}"); }
            }
            Rectangle { height: 1px; background: Theme.border; }
            HorizontalLayout {
                height: 32px;
                alignment: end;
                spacing: 10px;
                PanelButton { min-width: 86px; text: @tr("Cancel"); filled: true; enabled: root.enabled && !root.saving; clicked => { root.cancel(); } }
                PanelButton { min-width: 86px; text: root.saving ? @tr("Saving…") : @tr("Save"); accent: true; enabled: root.enabled && !root.saving && root.recording < 0; clicked => { root.save(); } }
            }
        }
    }
}
