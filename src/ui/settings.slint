import { ComboBox, ScrollView } from "std-widgets.slint";
import { PanelButton } from "controls.slint";
import { ShortcutEditor, ShortcutRow } from "shortcuts.slint";
export { ShortcutRow }
export struct MonitorChoice { id: string, label: string }

component SettingToggle inherits Rectangle {
    in property <string> text;
    in property <string> description;
    in property <bool> enabled;
    in-out property <bool> checked;
    height: 64px;
    border-radius: 4px;
    border-width: keys.has-focus ? 1px : 0px;
    border-color: #cdbf84;
    background: touch.has-hover && enabled ? #242829 : transparent;
    accessible-role: checkbox;
    accessible-label: text;
    accessible-enabled: enabled;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-action-default => { if (root.enabled) { root.checked = !root.checked; } }
    forward-focus: keys;
    HorizontalLayout {
        padding: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text { text: root.text; color: #e9e9e4; font-size: 14px; }
            Text { text: root.description; color: #a6adaa; font-size: 11px; wrap: word-wrap; }
        }
        Rectangle {
            width: 18px;
            height: 18px;
            border-radius: 3px;
            border-width: 1px;
            border-color: root.checked ? #cdbf84 : #69716d;
            background: root.checked ? #cdbf84 : transparent;
            if root.checked: Path {
                width: parent.width;
                height: parent.height;
                viewbox-width: 18;
                viewbox-height: 18;
                commands: "M 4 9 L 7.5 12.5 L 14 5.5";
                fill: transparent;
                stroke: #181b1c;
                stroke-width: 2px;
            }
        }
    }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                if (!event.repeat) { root.checked = !root.checked; }
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { keys.focus(); root.checked = !root.checked; }
    }
}

export component SettingsDialog inherits Rectangle {
    in property <bool> enabled;
    in property <[ShortcutRow]> rows;
    in property <[string]> monitor-labels;
    in-out property <int> selected-monitor;
    in-out property <bool> apply-in-saved-order;
    in-out property <bool> auto-ready-up;
    in-out property <bool> save-fallback-when-taken;
    in-out property <int> recording: -1;
    in property <string> error;
    in property <string> shortcut-warning;
    in property <bool> saving;
    private property <bool> general: true;
    callback clear(int);
    callback save();
    callback cancel();
    public function focus-dialog() { root.general = root.shortcut-warning == ""; keys.focus(); }
    background: #1d2122;
    border-color: #464c49;
    border-width: 1px;
    border-radius: 8px;
    TouchArea { }
    keys := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Escape && !root.saving) {
                if (root.recording >= 0) { root.recording = -1; } else { root.cancel(); }
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            padding: 22px;
            spacing: 12px;
            Text { text: "Settings"; color: #e9e9e4; font-size: 21px; height: 30px; }
            HorizontalLayout {
                height: 32px;
                alignment: start;
                spacing: 8px;
                PanelButton {
                    width: 100px; text: "General"; filled: root.general;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.recording = -1; root.general = true; }
                }
                PanelButton {
                    width: 100px; text: "Shortcuts"; filled: !root.general;
                    enabled: root.enabled && !root.saving;
                    clicked => { root.general = false; }
                }
            }
            Rectangle { height: 1px; background: #383d3b; }
            if root.general: ScrollView {
                content-width: self.visible-width - 8px;
                VerticalLayout {
                    alignment: start;
                    spacing: 6px;
                    SettingToggle {
                        text: "Apply Stratagems in saved order";
                        description: "Use the saved order when all four slots start empty.";
                        checked <=> root.apply-in-saved-order;
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: "Auto ready up";
                        description: "Ready up after successfully applying a Booster.";
                        checked <=> root.auto-ready-up;
                        enabled: root.enabled && !root.saving;
                    }
                    SettingToggle {
                        text: "Save fallback Booster when taken";
                        description: "If the saved Booster is in use, wait for your selection and save it as a fallback.";
                        checked <=> root.save-fallback-when-taken;
                        enabled: root.enabled && !root.saving;
                    }
                    Rectangle { height: 1px; background: #383d3b; }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;
                        Text { text: "Display"; color: #e9e9e4; font-size: 14px; }
                        ComboBox {
                            model: root.monitor-labels;
                            current-index <=> root.selected-monitor;
                            enabled: root.enabled && !root.saving;
                        }
                        Text { text: "Used for the panel and action status."; color: #a6adaa; font-size: 11px; wrap: word-wrap; }
                    }
                }
            }
            if !root.general: ShortcutEditor {
                rows: root.rows;
                recording <=> root.recording;
                enabled: root.enabled && !root.saving;
                clear(index) => { root.clear(index); }
            }
            if (!root.general && root.shortcut-warning != "" && root.error == ""): Text {
                text: "Currently unavailable:\n" + root.shortcut-warning;
                color: #e6b975;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("Currently unavailable:\n\{root.shortcut-warning}"); }
            }
            if (root.error != ""): Text {
                text: root.error;
                color: #e9b3a0;
                wrap: word-wrap;
                font-size: 12px;
                max-height: 56px;
                overflow: elide;
                Tooltip { text: @markdown("\{root.error}"); }
            }
            Rectangle { height: 1px; background: #383d3b; }
            HorizontalLayout {
                height: 32px;
                alignment: end;
                spacing: 10px;
                PanelButton { width: 86px; text: "Cancel"; filled: true; enabled: root.enabled && !root.saving; clicked => { root.cancel(); } }
                PanelButton { width: 86px; text: root.saving ? "Saving…" : "Save"; accent: true; enabled: root.enabled && !root.saving && root.recording < 0; clicked => { root.save(); } }
            }
        }
    }
}
