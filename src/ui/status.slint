import { NameImage } from "controls.slint";

export struct StatusItem { item-id: string, picture: image, confirmed: bool }

component ItemIcon inherits Rectangle {
    in property <StatusItem> item;
    width: 40px;
    height: 40px;
    Image {
        source: root.item.picture;
        width: parent.width;
        height: parent.height;
        image-fit: contain;
        opacity: root.item.confirmed ? 0.65 : 1;
    }
    if (root.item.confirmed): Rectangle {
        x: parent.width - self.width;
        y: parent.height - self.height;
        width: 13px;
        height: 13px;
        border-radius: 6px;
        background: #181b1c;
        Path {
            x: 3px; y: 3px;
            width: 8px; height: 7px;
            viewbox-width: 12; viewbox-height: 10;
            commands: "M 1 5 L 4 8 L 11 1";
            fill: transparent;
            stroke: #b8cbb7;
            stroke-width: 1.5px;
        }
    }
}

export component ActionStatus inherits Window {
    title: "HD2 Preset Helper — Status";
    no-frame: true;
    always-on-top: true;
    resize-border-width: 0px;
    width: 380px;
    height: 112px;
    background: #181b1c;
    default-font-family: "Segoe UI";
    in property <string> heading;
    in property <string> message;
    in property <color> accent: #e9d778;
    in property <image> picture;
    in property <[StatusItem]> stratagems;
    in property <StatusItem> booster;
    Rectangle { border-width: 1px; border-color: #383d3b; }
    Rectangle { x: 0px; y: 0px; width: 3px; height: parent.height; background: root.accent; }
    VerticalLayout {
        padding: 12px;
        spacing: 6px;
        alignment: start;
        Text { text: root.heading; color: root.accent; font-size: 13px; height: 16px; overflow: elide; }
        Text { text: root.message; color: #e9e9e4; font-size: 13px; min-height: 16px; wrap: word-wrap; overflow: elide; }
        if (root.stratagems.length > 0 || root.booster.item-id != ""): HorizontalLayout {
            height: 40px;
            spacing: 8px;
            alignment: start;
            for item in root.stratagems: ItemIcon { item: item; }
            if (root.stratagems.length > 0 && root.booster.item-id != ""): Rectangle {
                width: 12px;
                Rectangle { x: 5px; y: 4px; width: 1px; height: 32px; background: #383d3b; }
            }
            if (root.booster.item-id != ""): ItemIcon { item: root.booster; }
        }
        if (root.picture.width > 0): Rectangle {
            height: 40px;
            NameImage {
                x: 0px;
                y: 0px;
                source: root.picture;
                width: parent.width;
                height: 24px;
                colorize: #ffffff;
            }
        }
    }
}
