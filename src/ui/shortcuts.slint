import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { PanelButton } from "controls.slint";
import { ShortcutRow } from "models.slint";
import { UiText } from "text.slint";

component BindingRow inherits Rectangle {
    in property <ShortcutRow> item;
    in property <bool> recording;
    in property <bool> enabled: true;
    callback record();
    callback clear();
    height: 40px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.item.name == "" ? @tr("Open panel") : UiText.preset-title(root.item.label, root.item.number);
            color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1;
        }
        Rectangle {
            width: 218px;
            border-radius: 4px;
            border-width: 1px;
            border-color: root.recording ? Theme.accent : #424846;
            background: root.recording ? #302e22 : #202526;
            PanelButton {
                text: root.recording ? @tr("Press keys…") : root.item.binding == "" ? @tr("Unassigned") : root.item.binding;
                enabled: root.enabled;
                clicked => { root.record(); }
            }
        }
        PanelButton {
            width: 28px;
            text: "×";
            accessible-label: @tr("Clear shortcut");
            enabled: root.enabled && root.item.binding != "";
            clicked => { root.clear(); }
        }
    }
}

export component ShortcutEditor inherits VerticalLayout {
    in property <bool> enabled;
    in property <[ShortcutRow]> rows;
    in-out property <int> recording: -1;
    callback clear(int);
    spacing: 10px;
    Text { text: @tr("Click a shortcut and press your keys. Esc cancels recording."); color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
    BindingRow {
        item: root.rows[0];
        recording: root.recording == 0;
        enabled: root.enabled;
        record => { root.recording = 0; }
        clear => { root.clear(0); }
    }
    Text { text: @tr("The panel shortcut works globally; preset shortcuts work in the game or panel."); color: Theme.text-secondary; font-size: 11px; wrap: word-wrap; }
    Rectangle { height: 1px; background: Theme.border; }
    ScrollView {
        enabled: root.enabled;
        content-width: self.visible-width - 8px;
        VerticalLayout {
            alignment: start;
            spacing: 6px;
            for index in max(0, root.rows.length - 1): BindingRow {
                item: root.rows[index + 1];
                recording: root.recording == index + 1;
                enabled: root.enabled;
                record => { root.recording = index + 1; }
                clear => { root.clear(index + 1); }
            }
        }
    }
    Text { text: @tr("Num0–Num9 are keypad keys. Keep Num Lock on; avoid Shift with keypad digits."); color: Theme.text-disabled; font-size: 11px; wrap: word-wrap; }
}
