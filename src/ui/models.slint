// Semantic presentation data; fixed labels are generated by the UI.
export enum ActionScope { selected, stratagems, equipment }
export enum PreviewRole { stratagem, booster, fallback-booster, helmet, armor, cape, primary, secondary, throwable }
export enum PreviewState { missing, ready, invalid }
export struct PreviewRow { role: PreviewRole, number: int, state: PreviewState, picture: image, error: string }
export struct PreviewSection { items: [PreviewRow], summary: image, error: string, ready: bool, saved: bool }
export enum CandidateGroupRole { title, offensive, supply, defensive, all }
export struct CandidateRow { category: int, item: int, picture: image }
export struct CandidateGroupRow { title: image, role: CandidateGroupRole, items: [CandidateRow] }
export struct CandidateCatalogRow { groups: [CandidateGroupRow] }
export struct PresetRow {
    name: string,
    label: string,
    number: string,
    shortcut: string,
    stratagems: PreviewSection,
    equipment: PreviewSection,
}
export struct LibraryEntryRow {
    name: string,
    label: string,
    number: string,
    parent: string,
    is-folder: bool,
    expanded: bool,
    preset-index: int,
    top: float,
    height: float,
}
export struct EntryDropTarget { parent: string, before: string, top: float, inside: string, valid: bool, displace: bool }
export struct ShortcutRow { name: string, label: string, number: string, binding: string }
export enum MonitorRole { automatic, available, unavailable }
export struct MonitorChoice { id: string, role: MonitorRole, name: string, number: string, primary: bool }
