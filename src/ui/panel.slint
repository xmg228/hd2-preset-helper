import { Theme } from "theme.slint";
import { Icon, Icons, DragHandle } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { PanelButton, IconButton, DeletePresetDialog, NameImage, FailureNotice } from "controls.slint";
import { SettingsDialog } from "settings.slint";
import { UpdatePhase } from "updates.slint";
export { UpdatePhase }
import { ActionScope, PreviewRole, PreviewState, PreviewRow, PreviewSection, PresetRow, ShortcutRow, MonitorRole, MonitorChoice } from "models.slint";
import { UiText } from "text.slint";
import { FolderHeader } from "library.slint";
import { LibraryEntryRow, EntryDropTarget } from "models.slint";
export { LibraryEntryRow, EntryDropTarget }
export { ActionScope, PreviewRole, PreviewState, PreviewRow, PreviewSection, PresetRow, MonitorRole, ShortcutRow, MonitorChoice }
export { AppTray } from "tray.slint";
export { ActionStatus, StatusItem, StatusTone } from "status.slint";

component SelectableSection inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <string> detail-help;
    in property <bool> checked;
    in property <bool> enabled: true;
    in property <string> apply-label;
    in property <bool> apply-enabled;
    private property <bool> hovered: touch.has-hover;
    callback toggled();
    callback apply();
    vertical-stretch: 0;
    border-radius: 5px;
    forward-focus: keys;
    VerticalLayout {
        padding: 8px;
        spacing: 10px;
        HorizontalLayout {
            height: 28px;
            spacing: 8px;
            Rectangle {
                min-width: 0px;
                preferred-width: title.preferred-width + 24px;
                height: 28px;
                horizontal-stretch: 0;
                keys := FocusScope {
                    x: -8px;
                    y: -8px;
                    width: parent.width + 16px;
                    height: 44px;
                    focus-on-click: false;
                    enabled: root.enabled;
                    accessible-role: checkbox;
                    accessible-label: root.text;
                    accessible-enabled: root.enabled;
                    accessible-checkable: true;
                    accessible-checked: root.checked;
                    accessible-action-default => { if (root.enabled) { root.toggled(); } }
                    key-pressed(event) => {
                        if (event.text == Key.Space) {
                            if (!event.repeat) { root.toggled(); }
                            return accept;
                        }
                        return reject;
                    }
                    Rectangle {
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: keys.has-focus ? Theme.text-secondary : transparent;
                    }
                    touch := TouchArea {
                        enabled: root.enabled;
                        mouse-cursor: pointer;
                        clicked => { root.toggled(); }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    title := Text {
                        text: root.text;
                        color: root.enabled ? Theme.text : Theme.text-disabled;
                        font-size: 15px;
                        font-weight: 600;
                        min-width: 0px;
                        horizontal-stretch: 1;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        cross-axis-self-alignment: center;
                        border-radius: 3px;
                        border-width: 1px;
                        border-color: root.hovered && root.enabled ? Theme.accent
                            : root.checked ? (root.enabled ? #bdb078 : #59605d) : Theme.inactive;
                        background: root.checked ? (root.enabled ? Theme.accent-soft : #59605d) : transparent;
                        if (root.checked): Icon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            icon: Icons.check;
                            stroke: Theme.background;
                        }
                    }
                }
            }
            if (root.detail != ""): Text {
                text: root.detail;
                color: root.enabled ? Theme.text-secondary : Theme.text-disabled;
                font-size: 11px;
                min-width: 0px;
                horizontal-stretch: 0;
                overflow: elide;
                vertical-alignment: center;
                if (root.detail-help != ""): Tooltip {
                    text: @markdown("\{root.detail-help}");
                }
            }
            Rectangle { horizontal-stretch: 1; }
            IconButton {
                label: root.apply-label;
                outlined: true;
                enabled: root.enabled && root.apply-enabled;
                icon: Icons.apply;
                clicked => { root.apply(); }
            }
        }
        @children
    }
}

component EquipmentTile inherits Rectangle {
    in property <PreviewRow> item;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    min-height: 46px;
    border-radius: 4px;
    background: touch.has-hover && enabled ? Theme.control : transparent;
    border-width: 1px;
    border-color: keys.has-focus ? Theme.text-secondary : transparent;
    forward-focus: keys;
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
    VerticalLayout {
        alignment: center;
        padding: 4px;
        spacing: 2px;
        opacity: root.enabled ? (root.checked ? 1 : 0.5) : (root.checked ? 0.65 : 0.4);
        HorizontalLayout {
            height: 15px;
            spacing: 4px;
            Rectangle {
                width: 10px;
                if (root.checked): Icon {
                    size: 10px;
                    y: (parent.height - self.height) / 2;
                    icon: Icons.check;
                    stroke: root.enabled ? Theme.accent-soft : Theme.text-secondary;
                }
            }
            Text { text: UiText.item-label(root.item); color: Theme.text-secondary; font-size: 11px; }
        }
        Rectangle {
            height: 21px;
            if (root.item.state == PreviewState.ready): NameImage { source: root.item.picture; }
            if (root.item.state != PreviewState.ready): Text {
                text: root.item.state == PreviewState.invalid ? @tr("Preview unavailable") : @tr("Not saved");
                color: Theme.text-secondary;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
    if (root.item.error != ""): Tooltip { text: @markdown("\{root.item.error}"); }
    keys := FocusScope {
        enabled: root.enabled;
        focus-on-click: false;
        accessible-role: checkbox;
        accessible-label: UiText.item-label(root.item);
        accessible-enabled: root.enabled;
        accessible-checkable: true;
        accessible-checked: root.checked;
        accessible-action-default => { if (root.enabled) { root.toggled(); } }
        key-pressed(event) => {
            if (event.text == Key.Space) {
                if (!event.repeat) { root.toggled(); }
                return accept;
            }
            return reject;
        }
    }
}

component StratagemPreview inherits Rectangle {
    in property <[PreviewRow]> items;
    in property <length> icon-size: 40px;
    in property <bool> compact;
    min-height: icon-size;
    HorizontalLayout {
        y: (parent.height - self.height) / 2;
        height: root.icon-size;
        alignment: start;
        spacing: root.compact ? 5px : 8px;
        for item[index] in root.items: HorizontalLayout {
            spacing: root.compact ? 5px : 12px;
            if (index == 4 && !root.compact): Rectangle { width: 1px; background: Theme.border; }
            if (!root.compact || index < 5): Image {
                source: item.picture;
                width: root.icon-size;
                height: root.icon-size;
                image-fit: contain;
                Tooltip { text: @markdown("\{UiText.item-label(item)}"); }
            }
        }
    }
}

enum ReorderPhase { idle, dragging, committing }

component PresetCard inherits Rectangle {
    in property <PresetRow> item;
    in property <bool> compact;
    in property <bool> reorderable: true;
    in property <bool> selected;
    in property <bool> hovered;
    in property <bool> handle-hovered;
    out property <length> handle-width: 18px;
    in property <bool> scope-stratagems: true;
    in property <bool> scope-equipment: true;
    background: selected ? #302e22 : hovered ? #2d3032 : transparent;
    border-width: 1px;
    border-color: selected ? Theme.accent : transparent;
    border-radius: 5px;
    @children
    DragHandle {
        x: 0px;
        visible: root.reorderable;
        y: (parent.height - self.height) / 2;
        stroke: Theme.text-secondary;
        opacity: root.handle-hovered ? 1 : root.hovered ? 0.7 : 0.4;
    }
    VerticalLayout {
        padding: 5px;
        padding-left: root.handle-width + 4px;
        spacing: 2px;
        alignment: root.compact ? center : start;
        HorizontalLayout {
            height: 18px;
            spacing: 8px;
            Text { text: UiText.preset-title(root.item.label, root.item.number); color: Theme.text; overflow: elide; horizontal-stretch: 1; }
            Text {
                text: root.item.shortcut;
                max-width: 112px;
                color: Theme.text-secondary;
                font-size: 10px;
                overflow: elide;
                vertical-alignment: center;
                Tooltip { text: @markdown("\{root.item.shortcut}"); }
            }
        }
        if (!root.compact && root.item.stratagems.ready): StratagemPreview {
            height: 18px;
            icon-size: 18px;
            compact: true;
            items: root.item.stratagems.items;
            opacity: root.scope-stratagems ? 1 : 0.65;
        }
        if (!root.compact && root.item.equipment.ready): NameImage {
            source: root.item.equipment.summary;
            height: 14px;
            colorize: Theme.control-text;
            opacity: root.scope-equipment ? 1 : 0.65;
        }
        if (!root.compact && !root.item.stratagems.ready && !root.item.equipment.ready): Text {
            text: root.item.stratagems.saved || root.item.equipment.saved ? @tr("Preview unavailable") : @tr("Not saved");
            color: Theme.text-secondary;
            font-size: 11px;
            overflow: elide;
        }
    }
}

export component PresetPanel inherits Window {
    title: "HD2 Preset Helper";
    always-on-top: true;
    no-frame: true;
    resize-border-width: 5px;
    private property <length> ideal-width: 900px;
    private property <length> ideal-height: 620px;
    in property <length> available-width: ideal-width;
    in property <length> available-height: ideal-height;
    preferred-width: min(ideal-width, available-width);
    min-width: min(ideal-width, available-width);
    max-width: available-width;
    preferred-height: min(ideal-height, available-height);
    min-height: min(ideal-height, available-height);
    max-height: available-height;
    background: transparent;
    in property <string> ui-font-family;
    default-font-family: root.ui-font-family;
    default-font-size: 14px;

    in property <bool> presented: false;
    out property <duration> fade-duration: 83ms;
    out property <float> panel-opacity: presented ? 1 : 0;
    animate panel-opacity { duration: root.fade-duration; easing: linear; }

    in property <[PresetRow]> presets;
    in property <[LibraryEntryRow]> entries;
    in property <data-transfer> entry-drag-data;
    in property <string> status;
    in-out property <string> failure-details;
    in property <string> failure-label;
    in property <string> failure-number;
    in property <string> shortcut-warning;
    in property <bool> pending;
    in property <bool> loading: true;
    in property <[string]> panel-shortcut-keys;
    in-out property <bool> settings-open;
    out property <bool> viewing-licenses: settings.viewing-licenses;
    in-out property <bool> delete-open;
    in property <[ShortcutRow]> shortcut-rows;
    in property <[MonitorChoice]> monitor-choices;
    private property <[string]> monitor-labels: root.project-monitor-labels(
        root.monitor-choices, @tr("Follow game (automatic)"),
        @tr("Saved display (unavailable)"), @tr("Display"), @tr("Primary display"));
    in-out property <int> selected-monitor;
    in-out property <int> selected-language;
    in property <[string]> language-fonts;
    in property <bool> startup-available;
    in property <bool> initial-start-with-windows;
    in-out property <bool> draft-start-with-windows;
    in-out property <bool> draft-apply-in-saved-order;
    in-out property <bool> draft-auto-ready-up;
    in-out property <bool> draft-save-fallback-when-taken;
    in-out property <bool> draft-check-updates-automatically;
    in property <UpdatePhase> update-phase;
    in property <string> current-version;
    in property <string> update-version;
    in property <string> update-error;
    in property <float> update-download-fraction: -1;
    in property <string> update-download-size;
    in property <bool> update-install-allowed;
    out property <bool> update-installing: update-phase == UpdatePhase.installing || update-phase == UpdatePhase.restarting;
    in-out property <int> recording-shortcut: -1;
    in property <int> shortcut-settings-index: -1;
    in property <string> settings-error;
    in property <bool> settings-saving;
    in-out property <int> current-index: 0;
    in property <bool> compact-list;
    in-out property <string> search-query;
    out property <bool> editing-search: preset-search.has-focus;
    private property <bool> search-active: search-query != "";
    private property <[LibraryEntryRow]> visible-entries: root.project-entries(root.presets, root.entries,
        root.search-query, UiText.preset-title("", "{}"), root.row-height / 1px);
    private property <[int]> visible-presets: root.visible-preset-indices(root.visible-entries);
    private property <int> current-visible-index: root.visible-preset-index(root.visible-presets, root.current-index);
    private property <string> current-visible-entry: root.visible-entry(root.entries, root.current.name);
    in property <bool> scope-stratagems: true;
    in property <bool> scope-equipment: true;
    in property <[bool]> scope-equipment-items;
    in property <bool> equipment-items-selected: true;
    private property <PreviewState> equipment-state: root.selected-equipment-state(root.scope-equipment-items, current.equipment.items);
    private property <bool> include-stratagems: scope-stratagems && current.stratagems.saved;
    private property <bool> include-equipment: scope-equipment && equipment-state != PreviewState.missing;
    out property <bool> editing-name: editing-preset != "";
    out property <bool> editing-folder-name: editing-folder != "";
    out property <bool> reordering-entry: reorder-phase != ReorderPhase.idle;
    out property <bool> save-available: root.action-available(true, ActionScope.selected);
    out property <bool> available: root.action-available(false, ActionScope.selected);
    private property <PresetRow> current: presets[current-index];
    private property <int> hovered-index: -1;
    private property <PresetRow> preview: presets[!editing-name && !reordering-entry && hovered-index >= 0 ? hovered-index : current-index];
    private property <bool> interactive: presented && !pending && !loading && !settings-open && !delete-open && !update-installing
        && reorder-phase != ReorderPhase.committing;
    private property <string> editing-preset;
    private property <string> name-draft;
    private property <string> editing-folder;
    private property <string> folder-name-draft;
    private property <string> reveal-target;
    private property <bool> reveal-contents;
    private property <bool> apply-key-down;
    private property <bool> skip-delete-confirmation;
    private property <length> row-height: compact-list ? 36px : 68px;
    private property <length> row-spacing: 4px;
    private property <length> entry-indent: 20px;
    private property <ReorderPhase> reorder-phase;
    private property <length> drag-x;
    private property <length> drag-y;
    private property <length> drag-offset-y;
    private property <bool> drag-source-ready;
    private property <LibraryEntryRow> drag-entry;
    private property <length> drag-span;
    private property <bool> reorder-preview-visible: !search-active && reordering-entry && drag-source-ready;
    private property <length> drag-card-y: clamp(drag-y - drag-offset-y, 0px, max(0px, list-viewport.height - drag-entry.height * 1px));
    private property <EntryDropTarget> drop-target: root.entry-drop-target(root.visible-entries,
        root.reorder-preview-visible ? root.drag-entry.name : "", root.drag-x < root.entry-indent,
        (root.drag-y - preset-list.content-y) / 1px);
    private property <length> drop-y: drop-target.top * 1px - (drop-target.top > drag-entry.top ? drag-span + row-spacing : 0px);
    private property <length> insertion-y: drop-target.displace ? drop-y : drop-target.top * 1px;
    changed current-index => { root.commit-names(); root.reveal-current(); }
    changed compact-list => { root.hovered-index = -1; root.ensure-revealed(); }
    changed search-query => { root.reveal-current(); }
    changed visible-presets => {
        root.hovered-index = -1;
        root.apply-key-down = false;
        if (root.search-active || root.editing-folder-name) { root.reveal-current(); }
    }
    changed editing-search => { root.apply-key-down = false; root.hovered-index = -1; }
    changed editing-folder-name => { root.apply-key-down = false; root.hovered-index = -1; }
    callback request-action(bool, ActionScope);
    callback request-scope(ActionScope);
    callback request-equipment-item(int);
    pure callback selected-equipment-state([bool], [PreviewRow]) -> PreviewState;
    pure callback project-entries([PresetRow], [LibraryEntryRow], string, string, float) -> [LibraryEntryRow];
    pure callback visible-preset-indices([LibraryEntryRow]) -> [int];
    pure callback visible-preset-index([int], int) -> int;
    pure callback adjacent-preset([int], int, int) -> int;
    pure callback find-entry([LibraryEntryRow], string) -> LibraryEntryRow;
    pure callback visible-entry([LibraryEntryRow], string) -> string;
    pure callback entry-span([LibraryEntryRow], string) -> float;
    pure callback entry-drop-target([LibraryEntryRow], string, bool, float) -> EntryDropTarget;
    callback request-rename(string, string);
    callback request-delete(string);
    pure callback is-entry-drag(data-transfer) -> bool;
    callback request-reorder(string, string, string);
    callback add-folder();
    callback toggle-folder(string);
    callback request-folder-rename(string, string);
    callback request-ungroup(string);
    callback request-compact-list(bool);
    callback edit-settings(bool);
    callback edit-shortcut(string);
    callback save-settings();
    callback check-updates();
    callback view-update-notes();
    callback download-update();
    callback install-update();
    callback view-project();
    callback license-text() -> string;
    callback clear-shortcut(int);
    callback add-preset();
    callback duplicate-preset(string);
    callback dismiss();
    pure callback project-monitor-labels([MonitorChoice], string, string, string, string) -> [string];
    public function focus-list() {
        root.finish-reorder();
        if (!root.settings-open && !root.delete-open) { keyboard.focus(); }
    }
    public function focus-search-results() {
        if (root.current-visible-index < 0 && root.visible-presets.length > 0) {
            root.current-index = root.visible-presets[0];
        }
        root.focus-list();
    }
    public function finish-reorder() {
        root.reorder-phase = ReorderPhase.idle;
        root.drag-source-ready = false;
        root.hovered-index = -1;
        root.apply-key-down = false;
    }
    function begin-folder-rename(name: string, label: string) {
        root.commit-names();
        root.folder-name-draft = label;
        root.editing-folder = name;
        root.reveal-current();
    }
    function finish-folder-rename(save: bool) {
        if (root.editing-folder == "") { return; }
        let name = root.editing-folder;
        root.editing-folder = "";
        if (save) { root.request-folder-rename(name, root.folder-name-draft); }
    }
    public function focus-settings(show-about: bool) { root.hovered-index = -1; settings.focus-dialog(show-about); }
    public function close-dialogs() {
        if (root.settings-open) { settings.focus(); }
        if (root.delete-open) { delete-dialog.focus(); }
        root.settings-open = false;
        root.delete-open = false;
        root.recording-shortcut = -1;
        root.focus-list();
    }
    function begin-delete() {
        if (!root.interactive || root.presets.length == 0) { return; }
        root.commit-names();
        root.hovered-index = -1;
        root.apply-key-down = false;
        keyboard.focus();
        if (root.skip-delete-confirmation) {
            root.request-delete(root.current.name);
            return;
        }
        root.delete-open = true;
        delete-dialog.focus-dialog();
    }
    function begin-rename() {
        if (!root.interactive || root.presets.length == 0 || root.editing-name) { return; }
        root.commit-names();
        root.hovered-index = -1;
        root.apply-key-down = false;
        root.name-draft = root.current.label;
        root.editing-preset = root.current.name;
        name-input.scroll-offset = 0px;
        name-input.focus();
        name-input.select-all();
    }
    public function commit-names() {
        root.finish-rename(true);
        root.finish-folder-rename(true);
    }
    function finish-rename(save: bool) {
        if (!root.editing-name) { return; }
        let preset = root.editing-preset;
        root.editing-preset = "";
        if (save) { root.request-rename(preset, root.name-draft); }
    }
    function reveal-current() {
        if (root.reordering-entry) { return; }
        root.reveal-entry(root.editing-folder != "" ? root.editing-folder : root.current.name);
    }
    public function reveal-entry(name: string) {
        root.prepare-reveal(name, false);
        root.ensure-revealed();
    }
    public function prepare-reveal(name: string, contents: bool) {
        root.reveal-target = name;
        root.reveal-contents = contents;
    }
    public function ensure-revealed() {
        if (root.reordering-entry || root.reveal-target == "" || preset-list.visible-height <= 0px) { return; }
        let entry = root.find-entry(root.visible-entries, root.reveal-target);
        if (entry.name == "") { if (root.search-active) { preset-list.content-y = 0px; } return; }
        let top = entry.top * 1px;
        let span = root.reveal-contents && entry.is-folder && entry.expanded && !root.search-active
            ? root.entry-span(root.visible-entries, entry.name) : entry.height;
        let bottom = top + span * 1px;
        let height = preset-list.visible-height;
        let y = top + preset-list.content-y < 0px ? -top
            : bottom + preset-list.content-y > height ? max(-top, height - bottom) : preset-list.content-y;
        preset-list.content-y = clamp(y, min(0px, height - preset-list.content-height), 0px);
        root.reveal-contents = false;
    }
    function move-selection(delta: int) {
        let index = root.adjacent-preset(root.visible-presets, root.current-index, delta);
        if (index < 0) { return; }
        root.hovered-index = -1;
        root.apply-key-down = false;
        root.current-index = index;
        keyboard.focus();
    }
    public pure function action-available(saving: bool, scope: ActionScope) -> bool {
        let stratagems = scope == ActionScope.stratagems || (scope == ActionScope.selected && root.scope-stratagems);
        let equipment = root.equipment-items-selected
            && (scope == ActionScope.equipment || (scope == ActionScope.selected && root.scope-equipment));
        if (!root.interactive || root.reordering-entry || root.presets.length == 0
            || (root.search-active && root.current-visible-index < 0) || (!stratagems && !equipment)) { return false; }
        if (saving) { return true; }
        let include-stratagems = stratagems && root.current.stratagems.saved;
        let include-equipment = equipment && root.equipment-state != PreviewState.missing;
        return (include-stratagems || include-equipment)
            && (!include-stratagems || root.current.stratagems.ready)
            && (!include-equipment || root.equipment-state == PreviewState.ready);
    }
    function apply-current(scope: ActionScope) {
        if (root.action-available(false, scope)) {
            root.commit-names();
            root.request-action(false, scope);
        }
    }
    function save-current() {
        if (root.save-available) {
            root.commit-names();
            root.request-action(true, ActionScope.selected);
        }
    }

    surface := Rectangle {
        opacity: root.panel-opacity;
        Rectangle {
            background: #181b1cd1;
            border-radius: 8px;
            border-width: 1px;
            border-color: #ffffff20;
        }
        keyboard := FocusScope {
            enabled: root.presented && !root.settings-open && !root.delete-open;
            key-pressed(event) => {
                if (root.editing-name || root.editing-search || root.editing-folder-name) { return reject; }
                if (event.text == Key.Escape) {
                    if (root.search-active) { root.search-query = ""; }
                    else { root.dismiss(); }
                    return accept;
                }
                if (root.reordering-entry) { return accept; }
                if (!root.interactive) { return reject; }
                if (event.modifiers.control && !event.modifiers.shift && !event.modifiers.alt && !event.modifiers.meta
                    && (event.text == "s" || event.text == "S")) {
                    if (!event.repeat) { root.save-current(); }
                    return accept;
                }
                if (event.modifiers.control || event.modifiers.shift || event.modifiers.alt || event.modifiers.meta) { return reject; }
                let up = event.text == Key.UpArrow || event.text == "w" || event.text == "W";
                let down = event.text == Key.DownArrow || event.text == "s" || event.text == "S";
                if (up || down) {
                    root.move-selection(down ? 1 : -1);
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (!event.repeat) { root.apply-key-down = true; }
                    return accept;
                }
                return reject;
            }
            key-released(event) => {
                if (event.text == Key.Return) {
                    // Editing may end on key-down; its key-up must not apply a preset.
                    let apply = root.apply-key-down;
                    root.apply-key-down = false;
                    if (apply && !root.editing-name && !root.editing-search && !root.editing-folder-name && root.interactive) {
                        root.apply-current(ActionScope.selected);
                    }
                    return accept;
                }
                return reject;
            }
            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                HorizontalLayout {
                    height: 32px;
                    spacing: 12px;
                    Rectangle {
                        horizontal-stretch: 1;
                        WindowMoveArea {
                            x: root.resize-border-width - 18px;
                            y: root.resize-border-width - 18px;
                            width: parent.width - self.x;
                            height: parent.height - self.y + 12px;
                        }
                        HorizontalLayout {
                            alignment: start;
                            spacing: 8px;
                            Text {
                                text: "HD2 Preset Helper";
                                color: Theme.text;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "v" + root.current-version;
                                color: Theme.text-secondary;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if (root.update-phase == UpdatePhase.ready): PanelButton {
                        text: @tr("Restart to update");
                        height: 28px;
                        horizontal-stretch: 0;
                        cross-axis-self-alignment: center;
                        filled: true;
                        enabled: root.interactive;
                        clicked => {
                            root.commit-names();
                            root.edit-settings(true);
                            root.install-update();
                        }
                    }
                    if (root.update-version != "" && root.update-phase != UpdatePhase.ready): IconButton {
                        label: @tr("View available update");
                        icon: Icons.update;
                        enabled: root.interactive;
                        clicked => { root.commit-names(); root.edit-settings(true); }
                        Rectangle {
                            x: parent.width - 7px; y: 1px;
                            width: 5px; height: 5px; border-radius: 3px;
                            background: Theme.accent;
                        }
                    }
                    IconButton {
                        label: @tr("Settings");
                        icon: Icons.settings;
                        enabled: root.interactive;
                        clicked => { root.commit-names(); root.edit-settings(false); }
                    }
                    VerticalLayout {
                        width: 28px;
                        spacing: 0px;
                        IconButton {
                            height: 20px;
                            icon: Icons.minimize;
                            label: @tr("Hide panel");
                            clicked => { root.dismiss(); }
                        }
                        Text { text: "Esc"; color: Theme.text-secondary; font-size: 9px; height: 12px; horizontal-alignment: center; }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                HorizontalLayout {
                    min-height: 0px;
                    vertical-stretch: 1;
                    spacing: 18px;
                    VerticalLayout {
                        width: 210px;
                        spacing: 8px;
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            Rectangle {
                                horizontal-stretch: 1;
                                height: 30px;
                                background: Theme.control;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: preset-search.has-focus ? Theme.accent-soft : Theme.border;
                                TouchArea {
                                    enabled: root.interactive && !root.reordering-entry;
                                    mouse-cursor: text;
                                    clicked => { preset-search.focus(); }
                                }
                                Icon {
                                    x: 8px;
                                    y: (parent.height - self.height) / 2;
                                    icon: Icons.search;
                                    stroke: root.interactive ? Theme.text-secondary : Theme.inactive;
                                }
                                Text {
                                    x: 32px;
                                    width: parent.width - 42px;
                                    height: parent.height;
                                    text: @tr("Search presets");
                                    color: Theme.text-disabled;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    visible: root.search-query == "" && preset-search.preedit-text == "";
                                }
                                Rectangle {
                                    x: 32px;
                                    width: parent.width - self.x - (root.search-active ? 32px : 10px);
                                    height: parent.height;
                                    clip: true;
                                    preset-search := TextInput {
                                        property <length> scroll-offset;
                                        x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-offset));
                                        width: max(parent.width, self.preferred-width);
                                        height: parent.height;
                                        enabled: root.interactive && !root.reordering-entry;
                                        single-line: true;
                                        text <=> root.search-query;
                                        color: Theme.text;
                                        font-size: 13px;
                                        vertical-alignment: center;
                                        selection-background-color: #786c38;
                                        selection-foreground-color: #fff8d4;
                                        accessible-label: @tr("Search presets");
                                        cursor-position-changed(position) => {
                                            if (position.x + self.x < 0px) { self.scroll-offset = -position.x; }
                                            else if (position.x + self.x > parent.width - self.text-cursor-width) {
                                                self.scroll-offset = parent.width - self.text-cursor-width - position.x;
                                            }
                                        }
                                        key-pressed(event) => {
                                            if (self.preedit-text != "") { return reject; }
                                            if (event.text == Key.Escape) {
                                                if (root.search-active) { root.search-query = ""; keyboard.focus(); }
                                                else { root.dismiss(); }
                                                return accept;
                                            }
                                            if (event.modifiers.control || event.modifiers.shift || event.modifiers.alt || event.modifiers.meta) { return reject; }
                                            if (event.text == Key.Return) {
                                                if (!event.repeat && root.visible-presets.length > 0) { root.focus-search-results(); }
                                                return accept;
                                            }
                                            if (event.text == Key.UpArrow || event.text == Key.DownArrow) {
                                                if (root.visible-presets.length > 0) {
                                                    root.move-selection(event.text == Key.DownArrow ? 1 : -1);
                                                    keyboard.focus();
                                                }
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                }
                                IconButton {
                                    x: parent.width - self.width - 2px;
                                    y: (parent.height - self.height) / 2;
                                    label: @tr("Clear search");
                                    icon: Icons.close;
                                    visible: root.search-active;
                                    enabled: root.interactive && !root.reordering-entry;
                                    clicked => { root.search-query = ""; preset-search.focus(); }
                                }
                            }
                            IconButton {
                                cross-axis-self-alignment: center;
                                label: @tr("Compact list");
                                icon: Icons.list;
                                checkable: true;
                                checked: root.compact-list;
                                enabled: root.interactive && !root.reordering-entry;
                                clicked => {
                                    root.commit-names();
                                    keyboard.focus();
                                    root.request-compact-list(!root.compact-list);
                                }
                            }
                        }
                        list-viewport := Rectangle {
                            min-height: 0px;
                            width: 210px;
                            vertical-stretch: 1;
                            preset-list := ScrollView {
                                width: parent.width + 4px;
                                height: parent.height;
                                content-width: self.visible-width - 12px;
                                content-height: root.visible-entries.length > 0
                                    ? (root.visible-entries[root.visible-entries.length - 1].top
                                        + root.visible-entries[root.visible-entries.length - 1].height) * 1px : 0px;
                                changed visible-height => { root.ensure-revealed(); }
                                changed content-height => { root.ensure-revealed(); }
                                scrolled => { root.reveal-target = ""; }
                                VerticalLayout {
                                    alignment: start;
                                    spacing: root.row-spacing;
                                    for entry in root.visible-entries: Rectangle {
                                        height: entry.height * 1px;
                                        body := Rectangle {
                                            width: parent.width;
                                            height: parent.height;
                                            y: !root.reorder-preview-visible || !root.drop-target.displace ? 0px
                                                : entry.top >= root.drop-target.top && entry.top < root.drag-entry.top ? root.drag-span + root.row-spacing
                                                : entry.top * 1px > root.drag-entry.top * 1px + root.drag-span && entry.top < root.drop-target.top ? -root.drag-span - root.row-spacing : 0px;
                                            animate y { enabled: root.reorder-preview-visible; duration: 120ms; easing: ease-out; }
                                            opacity: root.reorder-preview-visible && entry.top >= root.drag-entry.top
                                                && entry.top * 1px < root.drag-entry.top * 1px + root.drag-span
                                                ? (root.drop-target.displace ? 0 : 0.35) : 1;
                                            if (entry.is-folder): FolderHeader {
                                                width: parent.width;
                                                height: parent.height;
                                                item: entry;
                                                enabled: root.interactive && !root.reordering-entry;
                                                reorderable: !root.search-active;
                                                collapsible: !root.search-active;
                                                handle-hovered: handle.has-hover;
                                                highlighted: root.reorder-preview-visible && root.drop-target.inside == entry.name;
                                                contains-current: !entry.expanded && entry.name == root.current-visible-entry;
                                                editing: root.editing-folder == entry.name;
                                                draft <=> root.folder-name-draft;
                                                clicked => { keyboard.focus(); }
                                                toggled => {
                                                    root.hovered-index = -1;
                                                    root.apply-key-down = false;
                                                    root.reveal-target = "";
                                                    root.toggle-folder(entry.name);
                                                }
                                                rename => { root.begin-folder-rename(entry.name, entry.label); }
                                                ungroup => { keyboard.focus(); root.request-ungroup(entry.name); }
                                                finish-rename(save) => { root.finish-folder-rename(save); }
                                            }
                                            if (!entry.is-folder): PresetCard {
                                                x: entry.parent == "" ? 0px : root.entry-indent;
                                                width: parent.width - self.x;
                                                height: parent.height;
                                                item: root.presets[entry.preset-index];
                                                compact: root.compact-list;
                                                reorderable: !root.search-active;
                                                selected: entry.preset-index == root.current-index;
                                                hovered: touch.has-hover || handle.has-hover;
                                                handle-hovered: handle.has-hover;
                                                scope-stratagems: root.scope-stratagems;
                                                scope-equipment: root.scope-equipment && root.equipment-items-selected;
                                                accessible-role: button;
                                                accessible-label: UiText.preset-title(self.item.label, self.item.number);
                                                accessible-description: UiText.section-message(self.item.stratagems) + " " + UiText.section-message(self.item.equipment);
                                                accessible-enabled: root.interactive && !root.reordering-entry;
                                                accessible-action-default => { root.current-index = entry.preset-index; }
                                                changed hovered => {
                                                    if (self.hovered) { root.hovered-index = entry.preset-index; }
                                                    else if (root.hovered-index == entry.preset-index) { root.hovered-index = -1; }
                                                }
                                                touch := TouchArea {
                                                    x: root.search-active ? 0px : 18px;
                                                    width: parent.width - self.x;
                                                    enabled: root.interactive && !root.reordering-entry;
                                                    mouse-cursor: pointer;
                                                    pointer-event(event) => {
                                                        if (event.kind == PointerEventKind.move) { root.hovered-index = entry.preset-index; }
                                                    }
                                                    clicked => { root.current-index = entry.preset-index; keyboard.focus(); }
                                                    double-clicked => { root.apply-current(ActionScope.selected); }
                                                }
                                            }
                                            drag := DragArea {
                                                x: entry.parent == "" ? 0px : root.entry-indent;
                                                y: 0px;
                                                width: 18px;
                                                height: parent.height;
                                                enabled: root.interactive && !root.editing-name && !root.editing-folder-name && !root.search-active;
                                                data: root.entry-drag-data;
                                                allow-move: true;
                                                changed dragging => {
                                                    if (self.dragging) {
                                                        root.reorder-phase = ReorderPhase.dragging;
                                                        root.reveal-target = "";
                                                        if (!entry.is-folder) { root.current-index = entry.preset-index; }
                                                        root.hovered-index = -1;
                                                        root.apply-key-down = false;
                                                        keyboard.focus();
                                                    }
                                                }
                                                drag-finished(action) => {
                                                    if (action == DragAction.move && root.drop-target.valid) {
                                                        root.reorder-phase = ReorderPhase.committing;
                                                        root.request-reorder(root.drag-entry.name, root.drop-target.parent, root.drop-target.before);
                                                    } else {
                                                        root.finish-reorder();
                                                    }
                                                }
                                                handle := TouchArea {
                                                    enabled: root.interactive && !root.editing-name && !root.editing-folder-name && !root.search-active;
                                                    mouse-cursor: self.pressed ? grabbing : grab;
                                                    pointer-event(event) => {
                                                        if (event.kind == PointerEventKind.down && event.button == PointerEventButton.left) {
                                                            root.drag-source-ready = true;
                                                            root.drag-entry = entry;
                                                            root.drag-span = root.entry-span(root.visible-entries, entry.name) * 1px;
                                                            root.drag-offset-y = self.mouse-y;
                                                            root.drag-x = self.mouse-x + self.absolute-position.x - list-viewport.absolute-position.x;
                                                            root.drag-y = entry.top * 1px + preset-list.content-y + self.mouse-y;
                                                        } else if (event.kind == PointerEventKind.up && root.reorder-phase == ReorderPhase.idle) {
                                                            root.drag-source-ready = false;
                                                        }
                                                        if (event.kind == PointerEventKind.move && !entry.is-folder) { root.hovered-index = entry.preset-index; }
                                                    }
                                                    clicked => {
                                                        if (!entry.is-folder) { root.current-index = entry.preset-index; }
                                                        keyboard.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if (root.search-active && root.visible-presets.length == 0): Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                                text: @tr("No matching presets");
                                color: Theme.text-secondary;
                                font-size: 13px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                            Rectangle {
                                x: 0px;
                                y: 0px;
                                width: preset-list.content-width;
                                height: parent.height;
                                clip: true;
                                Rectangle {
                                    visible: root.reorder-preview-visible;
                                    x: (root.drop-target.valid ? root.drop-target.parent : root.drag-entry.parent) == "" ? 0px : root.entry-indent;
                                    y: root.reorder-phase == ReorderPhase.committing && root.drop-target.inside == ""
                                        ? root.drop-y + preset-list.content-y : root.drag-card-y;
                                    width: parent.width - self.x;
                                    height: root.drag-entry.height * 1px;
                                    animate x { enabled: root.reorder-preview-visible; duration: 120ms; easing: ease-out; }
                                    drop-shadow-color: #00000080;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-offset-y: 2px;
                                    if (root.drag-entry.is-folder): FolderHeader {
                                        width: parent.width;
                                        height: parent.height;
                                        item: root.drag-entry;
                                        enabled: false;
                                        highlighted: true;
                                        handle-hovered: true;
                                    }
                                    if (!root.drag-entry.is-folder): PresetCard {
                                        width: parent.width;
                                        height: parent.height;
                                        item: root.presets[max(0, root.drag-entry.preset-index)];
                                        compact: root.compact-list;
                                        selected: true;
                                        handle-hovered: true;
                                        scope-stratagems: root.scope-stratagems;
                                        scope-equipment: root.scope-equipment && root.equipment-items-selected;
                                    }
                                }
                                Rectangle {
                                    visible: root.reorder-preview-visible && root.drop-target.valid && root.drop-target.inside == "";
                                    x: root.drop-target.parent == "" ? 0px : root.entry-indent;
                                    y: max(0px, root.insertion-y + preset-list.content-y - root.row-spacing / 2 - 1px);
                                    width: parent.width - self.x;
                                    height: 2px;
                                    background: Theme.accent;
                                    Rectangle {
                                        x: 0px;
                                        y: -2px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                    }
                                }
                            }
                            Timer {
                                interval: 16ms;
                                running: list-drop.has-drag && root.reorder-phase == ReorderPhase.dragging
                                    && (root.drag-y < 28px || root.drag-y > list-viewport.height - 28px);
                                triggered => {
                                    let step = root.drag-y < 28px ? 8px : -8px;
                                    preset-list.content-y = clamp(preset-list.content-y + step,
                                        min(0px, preset-list.visible-height - preset-list.content-height), 0px);
                                }
                            }
                        }
                        HorizontalLayout {
                            height: 30px;
                            spacing: 8px;
                            PanelButton {
                                horizontal-stretch: 1;
                                text: @tr("+ New preset");
                                filled: true;
                                enabled: root.interactive;
                                clicked => { root.commit-names(); root.add-preset(); }
                            }
                            IconButton {
                                label: @tr("New folder");
                                icon: Icons.folder-plus;
                                enabled: root.interactive && !root.reordering-entry;
                                clicked => { root.commit-names(); root.add-folder(); }
                            }
                        }
                    }
                    Rectangle { width: 1px; background: Theme.border; }
                    ScrollView {
                        min-width: 0px;
                        min-height: 0px;
                        horizontal-stretch: 1;
                        content-width: max(360px, self.visible-width - 8px);
                        VerticalLayout {
                            padding-top: 6px;
                            spacing: 16px;
                            alignment: start;
                            HorizontalLayout {
                                height: 32px;
                                padding-left: 8px;
                                padding-right: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    Rectangle {
                                        x: -6px;
                                        width: parent.width + 12px;
                                        height: parent.height;
                                        border-radius: 3px;
                                        background: root.editing-name ? #222627 : transparent;
                                        animate background { duration: 120ms; easing: ease-out; }
                                    }
                                    Rectangle {
                                        x: -6px;
                                        y: parent.height - 1px;
                                        width: parent.width + 12px;
                                        height: 1px;
                                        background: root.editing-name ? Theme.accent-soft : transparent;
                                        animate background { duration: 120ms; easing: ease-out; }
                                    }
                                    name-title := Text {
                                        x: 0px;
                                        width: min(self.preferred-width, shortcut-button.x - rename-button.width - 16px);
                                        height: parent.height;
                                        visible: !root.editing-name || (root.name-draft == "" && name-input.preedit-text == "");
                                        text: root.presets.length > 0
                                            ? UiText.preset-title(root.editing-name ? "" : root.preview.label, root.preview.number)
                                            : @tr("No presets");
                                        color: root.editing-name ? Theme.text-disabled : Theme.text;
                                        font-size: 21px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                        TouchArea {
                                            enabled: root.interactive && !root.editing-name
                                                && !root.reordering-entry && root.presets.length > 0;
                                            double-clicked => { root.begin-rename(); }
                                        }
                                    }
                                    Rectangle {
                                        x: 0px;
                                        visible: root.editing-name;
                                        width: parent.width;
                                        height: parent.height;
                                        clip: true;
                                        ContextMenuArea {
                                            Menu {
                                                MenuItem { title: @tr("Cut"); activated => { name-input.cut(); } }
                                                MenuItem { title: @tr("Copy"); activated => { name-input.copy(); } }
                                                MenuItem { title: @tr("Paste"); activated => { name-input.paste(); } }
                                                MenuItem { title: @tr("Select all"); activated => { name-input.select-all(); } }
                                            }
                                            name-input := TextInput {
                                                property <length> scroll-offset;
                                                x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-offset));
                                                width: max(parent.width, self.preferred-width);
                                                height: parent.height;
                                                enabled: root.interactive;
                                                single-line: true;
                                                text <=> root.name-draft;
                                                color: Theme.text;
                                                font-size: name-title.font-size;
                                                vertical-alignment: center;
                                                selection-background-color: #786c38;
                                                selection-foreground-color: #fff8d4;
                                                accessible-label: @tr("Preset name");
                                                cursor-position-changed(position) => {
                                                    if (position.x + self.x < 0px) {
                                                        self.scroll-offset = -position.x;
                                                    } else if (position.x + self.x > parent.width - self.text-cursor-width) {
                                                        self.scroll-offset = parent.width - self.text-cursor-width - position.x;
                                                    }
                                                }
                                                accepted => { root.finish-rename(true); keyboard.focus(); }
                                                changed has-focus => { if (!self.has-focus) { root.finish-rename(true); } }
                                                key-pressed(event) => {
                                                    if (self.preedit-text != "") { return reject; }
                                                    if (event.text == Key.Escape) {
                                                        root.finish-rename(false);
                                                        keyboard.focus();
                                                        return accept;
                                                    }
                                                    return reject;
                                                }
                                            }
                                        }
                                    }
                                    rename-button := IconButton {
                                        x: name-title.width + 8px;
                                        y: (parent.height - self.height) / 2;
                                        visible: !root.editing-name && root.presets.length > 0;
                                        enabled: root.interactive;
                                        label: @tr("Rename preset");
                                        icon: Icons.rename;
                                        clicked => { root.begin-rename(); }
                                    }
                                    shortcut-button := IconButton {
                                        x: copy-button.x - self.width - 4px;
                                        y: (parent.height - self.height) / 2;
                                        visible: !root.editing-name && root.presets.length > 0;
                                        enabled: root.interactive;
                                        label: @tr("Set shortcut");
                                        icon: Icons.keyboard;
                                        clicked => { root.commit-names(); root.edit-shortcut(root.current.name); }
                                    }
                                    copy-button := IconButton {
                                        x: delete-button.x - self.width - 4px;
                                        y: (parent.height - self.height) / 2;
                                        visible: !root.editing-name && root.presets.length > 0;
                                        enabled: root.interactive && !root.reordering-entry;
                                        label: @tr("Duplicate preset");
                                        icon: Icons.copy;
                                        clicked => { root.commit-names(); root.duplicate-preset(root.current.name); }
                                    }
                                    delete-button := IconButton {
                                        x: parent.width - self.width;
                                        y: (parent.height - self.height) / 2;
                                        visible: !root.editing-name && root.presets.length > 0;
                                        enabled: root.interactive;
                                        label: @tr("Delete preset");
                                        icon: Icons.delete;
                                        clicked => { root.begin-delete(); }
                                    }
                                }
                            }
                            SelectableSection {
                                text: @tr("Stratagems & Booster");
                                checked: root.scope-stratagems;
                                enabled: root.interactive;
                                apply-label: @tr("Apply Stratagems");
                                apply-enabled: root.action-available(false, ActionScope.stratagems);
                                apply => { root.apply-current(ActionScope.stratagems); }
                                toggled => {
                                    root.commit-names();
                                    root.request-scope(ActionScope.stratagems);
                                }
                                Rectangle {
                                    height: 48px;
                                    if (root.preview.stratagems.ready): StratagemPreview {
                                        icon-size: 44px;
                                        items: root.preview.stratagems.items;
                                        opacity: root.scope-stratagems ? 1 : 0.65;
                                    }
                                    if (!root.preview.stratagems.ready): Text {
                                        text: root.presets.length > 0 ? UiText.section-message(root.preview.stratagems) : @tr("Use + New preset to get started.");
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle { height: 1px; background: Theme.border; }
                            SelectableSection {
                                text: @tr("Equipment");
                                detail: !root.loading && root.preview.equipment.ready && root.preview.equipment-cache-matches >= 0
                                    ? @tr("Cache coverage: {}/{}", root.preview.equipment-cache-matches, root.preview.equipment.count) : "";
                                detail-help: @tr("Based on complete category caches. Uncovered items may still apply without scanning.");
                                checked: root.scope-equipment;
                                enabled: root.interactive;
                                apply-label: @tr("Apply equipment");
                                apply-enabled: root.action-available(false, ActionScope.equipment);
                                apply => { root.apply-current(ActionScope.equipment); }
                                toggled => {
                                    root.commit-names();
                                    root.request-scope(ActionScope.equipment);
                                }
                                Rectangle {
                                    height: 100px;
                                    if (root.presets.length > 0): VerticalLayout {
                                        spacing: 8px;
                                        for row in 2: HorizontalLayout {
                                            spacing: 14px;
                                            for column in 3: EquipmentTile {
                                                item: root.preview.equipment.items[row * 3 + column];
                                                checked: root.scope-equipment-items[row * 3 + column];
                                                enabled: root.interactive && root.scope-equipment;
                                                toggled => { root.request-equipment-item(row * 3 + column); }
                                            }
                                        }
                                    }
                                    if (root.presets.length == 0): Text {
                                        text: UiText.section-message(root.preview.equipment);
                                        color: Theme.text-secondary;
                                        wrap: word-wrap;
                                        font-size: 12px;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border; }
                VerticalLayout {
                    vertical-stretch: 0;
                    spacing: 8px;
                    if (!root.loading && root.failure-details != "" && root.status == ""): FailureNotice {
                        details: UiText.preset-title(root.failure-label, root.failure-number) + " — " + root.failure-details;
                        dismissed => { root.failure-details = ""; }
                    }
                    if (root.loading || root.failure-details == "" || root.status != ""): Text {
                        text: root.loading ? @tr("Loading previews…") : root.status != "" ? root.status
                            : root.search-active && root.current-visible-index < 0 ? @tr("Select a preset")
                            : root.scope-stratagems || (root.scope-equipment && root.equipment-items-selected) ? @tr("Start from either loadout page.")
                            : @tr("Select content to save or apply.");
                        color: Theme.text-secondary;
                        wrap: word-wrap;
                        font-size: 12px;
                    }
                    if (root.shortcut-warning != ""): Text {
                        text: @tr("Some shortcuts are unavailable. See Settings → Shortcuts.");
                        color: Theme.warning;
                        font-size: 12px;
                        wrap: word-wrap;
                        Tooltip { text: @markdown("\{root.shortcut-warning}"); }
                    }
                    Rectangle {
                        min-width: 0px;
                        preferred-width: 0px;
                        height: actions.stacked ? 112px : 50px;
                        actions := GridLayout {
                            x: 0px;
                            width: parent.width;
                            property <bool> stacked: root.width < shortcut-hint.preferred-width + save-action.width + apply-action.width + 60px;
                            height: parent.height;
                            spacing: 12px;
                            shortcut-hint := Rectangle {
                                row: 0; col: 0; colspan: actions.stacked ? 3 : 1;
                                height: 50px;
                                horizontal-stretch: 1;
                                if (root.panel-shortcut-keys.length > 0): VerticalLayout {
                                    spacing: 4px;
                                    HorizontalLayout {
                                        height: 32px;
                                        alignment: start;
                                        spacing: 8px;
                                        for key in root.panel-shortcut-keys: Rectangle {
                                            height: 32px;
                                            width: panel-key.preferred-width + 14px;
                                            Rectangle {
                                                y: (parent.height - self.height) / 2;
                                                height: 26px;
                                                width: parent.width;
                                                border-radius: 3px;
                                                border-width: 1px;
                                                border-color: Theme.inactive;
                                                background: Theme.control;
                                            }
                                            panel-key := Text {
                                                text: key;
                                                color: Theme.text;
                                                font-size: 12px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text { text: @tr("Show / hide panel"); color: Theme.text; font-size: 13px; height: 32px; vertical-alignment: center; }
                                    }
                                    Text { text: @tr("Global shortcut"); color: Theme.text-secondary; font-size: 10px; height: 14px; }
                                }
                            }
                            save-action := VerticalLayout {
                                row: actions.stacked ? 1 : 0; col: 1;
                                height: 50px;
                                width: max(150px, save-button.preferred-width);
                                spacing: 4px;
                                save-button := PanelButton {
                                    height: 32px;
                                    text: root.scope-stratagems ? (root.scope-equipment && root.equipment-items-selected ? @tr("Save preset") : @tr("Save Stratagems"))
                                        : root.scope-equipment && root.equipment-items-selected ? @tr("Save equipment") : @tr("Select content");
                                    filled: true;
                                    enabled: root.save-available;
                                    property <string> hint: @tr("Fill all four Stratagem slots before saving.");
                                    if (root.scope-stratagems): Tooltip { text: @markdown("\{parent.hint}"); }
                                    clicked => { root.save-current(); }
                                }
                                Text {
                                    text: "Ctrl+S";
                                    color: root.save-available ? Theme.text-secondary : Theme.inactive;
                                    font-size: 10px;
                                    height: 14px;
                                    horizontal-alignment: center;
                                }
                            }
                            apply-action := VerticalLayout {
                                row: actions.stacked ? 1 : 0; col: 2;
                                height: 50px;
                                width: max(150px, apply-button.preferred-width);
                                spacing: 4px;
                                apply-button := PanelButton {
                                    height: 32px;
                                    text: root.include-stratagems ? (root.include-equipment ? @tr("Apply preset") : @tr("Apply Stratagems"))
                                        : root.include-equipment ? @tr("Apply equipment") : @tr("Select content");
                                    accent: true;
                                    enabled: root.available;
                                    clicked => { root.apply-current(ActionScope.selected); }
                                }
                                Text {
                                    text: "Enter";
                                    color: root.available ? Theme.text-secondary : Theme.inactive;
                                    font-size: 10px;
                                    height: 14px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
        // The preview stays on the vertical axis; horizontal intent chooses the drop level.
        list-drop := DropArea {
            x: 0px;
            y: list-viewport.absolute-position.y - surface.absolute-position.y;
            width: parent.width;
            height: list-viewport.height;
            enabled: root.interactive && !root.editing-name && !root.editing-folder-name && !root.search-active && root.drag-source-ready;
            can-drop(event) => {
                if (!root.is-entry-drag(event.data)) { return DragAction.none; }
                root.reorder-phase = ReorderPhase.dragging;
                root.drag-x = event.position.x + self.absolute-position.x - list-viewport.absolute-position.x;
                root.drag-y = event.position.y;
                return DragAction.move;
            }
            dropped(event) => { return self.can-drop(event); }
        }
        if (root.settings-open): Rectangle {
            background: #00000099;
            border-radius: 8px;
            TouchArea { }
        }
        settings := SettingsDialog {
            visible: root.settings-open;
            enabled: root.settings-open && !root.pending && !root.update-installing;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.shortcut-settings-index > 0 ? 440px : 560px, parent.width - 32px);
            height: root.shortcut-settings-index > 0 ? self.preferred-height : min(560px, parent.height - 32px);
            shortcut-index: root.shortcut-settings-index;
            rows: root.shortcut-rows;
            monitor-labels: root.monitor-labels;
            selected-monitor <=> root.selected-monitor;
            selected-language <=> root.selected-language;
            language-fonts: root.language-fonts;
            startup-available: root.startup-available;
            start-with-windows <=> root.draft-start-with-windows;
            apply-in-saved-order <=> root.draft-apply-in-saved-order;
            auto-ready-up <=> root.draft-auto-ready-up;
            save-fallback-when-taken <=> root.draft-save-fallback-when-taken;
            check-updates-automatically <=> root.draft-check-updates-automatically;
            update-phase: root.update-phase;
            current-version: root.current-version;
            update-version: root.update-version;
            update-error: root.update-error;
            update-download-fraction: root.update-download-fraction;
            update-download-size: root.update-download-size;
            update-install-allowed: root.update-install-allowed;
            recording <=> root.recording-shortcut;
            error: root.settings-error;
            shortcut-warning: root.shortcut-warning;
            saving: root.settings-saving;
            clear(index) => { root.clear-shortcut(index); }
            save => { root.save-settings(); }
            cancel => { root.close-dialogs(); }
            check-updates => { root.check-updates(); }
            view-update-notes => { root.view-update-notes(); }
            download-update => { root.download-update(); }
            install-update => { root.install-update(); }
            view-project => { root.view-project(); }
            license-text => { root.license-text(); }
        }
        if (root.delete-open): Rectangle {
            background: #00000099;
            border-radius: 8px;
            TouchArea { }
        }
        delete-dialog := DeletePresetDialog {
            visible: root.delete-open;
            enabled: root.delete-open;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(420px, parent.width - 32px);
            height: self.preferred-height;
            preset-title: UiText.preset-title(root.current.label, root.current.number);
            confirm(skip-confirmation) => {
                root.skip-delete-confirmation = skip-confirmation;
                root.request-delete(root.current.name);
                root.close-dialogs();
            }
            cancel => { root.close-dialogs(); }
        }
    }
}
