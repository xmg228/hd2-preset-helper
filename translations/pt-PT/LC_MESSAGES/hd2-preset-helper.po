# Item scanning.
msgid "Item cache"
msgstr "Cache de itens"

msgid "All items"
msgstr "Todos os itens"

msgid "Stratagems"
msgstr "Estratagemas"

msgid "Scan"
msgstr "Analisar"

msgid "Item scan"
msgstr "Análise de itens"

msgid "Open the panel to stop scanning."
msgstr "Abre o painel para parar a análise."

msgid "For clearer icons, scan Boosters when none are in use."
msgstr "Para obter ícones mais nítidos, analisa os impulsionadores quando nenhum estiver em uso."

# Item editing.
msgid "Edit loadout"
msgstr "Editar configuração"

msgid "Randomize Stratagems & Booster"
msgstr "Sortear estratagemas e reforço"

msgid "Offensive"
msgstr "Ofensivo"

msgid "Supply"
msgstr "Mantimentos"

msgid "Defensive"
msgstr "Defensivo"

msgid "Clear"
msgstr "Limpar"

msgid "Loading…"
msgstr "A carregar…"

msgid "No items available. You can scan this list now. Missing lists are also scanned automatically when you first apply the corresponding item types."
msgstr "Nenhum item disponível. Podes analisar esta lista agora. As listas em falta também são analisadas automaticamente na primeira aplicação dos tipos de item correspondentes."

msgid "Quick start"
msgstr "Início rápido"

msgid "Set up your loadout in the game, select a preset, then choose “{}”."
msgstr "Prepara o teu equipamento no jogo, seleciona uma predefinição e escolhe «{}»."

msgid "To use it later, select the preset and choose “{}”, or use its shortcut."
msgstr "Para a usares mais tarde, seleciona a predefinição e escolhe «{}» ou usa o respetivo atalho."

msgid "You can also use “{}” to change items or randomize your loadout. Required lists are scanned automatically when you first apply each item type, or you can scan them in advance."
msgstr "Também podes usar «{}» para alterar itens ou criar uma configuração aleatória. As listas necessárias são analisadas automaticamente na primeira vez que aplicas cada tipo de item, ou podes analisá-las antecipadamente."

msgid "Got it"
msgstr "Percebi"

msgid "Save changes"
msgstr "Guardar alterações"

msgid "Randomize equipment"
msgstr "Sortear equipamento"

msgid "Scan all missing lists"
msgstr "Analisar todas as listas em falta"

msgid "Capture from game"
msgstr "Guardar do jogo"

msgid "Apply to game"
msgstr "Aplicar no jogo"

msgid "Scan the required item lists ({}) once to build the cache. This may take a while; the cache is reused when applying presets."
msgstr "Na primeira utilização, é necessário analisar {} listas de itens e criar a cache, o que pode demorar. As aplicações seguintes reutilizarão a cache, sem analisar de cada vez."

# Item-list confirmation.
msgid "Build item cache"
msgstr "Criar cache de itens"

msgid "Build cache and apply"
msgstr "Criar cache e aplicar"

msgid "Rescan this list"
msgstr "Analisar esta lista novamente"

msgid "Scan this list"
msgstr "Analisar esta lista"

msgid "Scan this list from the game. All unsaved edits will be discarded."
msgstr "Analisa esta lista no jogo. Todas as alterações por guardar serão descartadas."

msgid "Missing an item?"
msgstr "Falta algum item?"

msgid "Scan missing lists from the game. All unsaved edits will be discarded."
msgstr "Analisa as listas em falta no jogo. Todas as alterações por guardar serão descartadas."

# Tray.
msgid "Exit"
msgstr "Sair"
