# Item scanning.
msgid "Item cache"
msgstr "Cache de itens"

msgid "Migrate presets"
msgstr "Migrar predefinições"

msgid "Scan item lists"
msgstr "Analisar listas de itens"

msgid "Check presets"
msgstr "Verificar predefinições"

msgid "Check new lists"
msgstr "Verificar novas listas"

msgid "Refresh saved preset images after a game language change or Stratagem icon update."
msgstr "Atualize as imagens das predefinições guardadas após uma mudança no idioma do jogo ou uma atualização dos ícones de estratagemas."

msgid "Requires complete caches from a previous scan of the selected item types, with no changes to available items."
msgstr "Requer caches completas de uma análise anterior dos tipos de itens selecionados, sem alterações nos itens disponíveis."

msgid "Check saved images against the existing cache, then scan new lists."
msgstr "Compare as imagens guardadas com a cache existente e analise as novas listas."

msgid "Check the old and new lists, then confirm the migration."
msgstr "Compare as listas antigas e novas e confirme a migração."

msgid "{} saved slots across {} presets were located in the existing cache."
msgstr "Itens guardados encontrados na cache existente: {} · Predefinições: {}."

