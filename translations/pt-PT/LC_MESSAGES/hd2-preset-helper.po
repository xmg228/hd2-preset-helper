# General settings.
msgid "General"
msgstr "Geral"

msgid "Shortcuts"
msgstr "Atalhos"

msgid "Apply Stratagems in saved order"
msgstr "Aplicar estratagemas pela ordem guardada"

msgid "Only when all four slots start empty."
msgstr "Só quando os quatro espaços estiverem vazios no início."

msgid "Auto ready up"
msgstr "Pronto automaticamente"

msgid "Ready up after successfully applying a Booster."
msgstr "Marca-te como pronto após aplicar um impulsionador com êxito."

msgid "Save fallback Booster when taken"
msgstr "Guardar alternativa se outro usar o impulsionador"

