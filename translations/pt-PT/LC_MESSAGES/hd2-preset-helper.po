msgstr "Guardar"

# Shortcut settings.
msgid "Open panel"
msgstr "Abrir painel"

msgid "Press keys…"
msgstr "Prime as teclas…"

msgid "Unassigned"
msgstr "Não atribuído"

msgid "Clear shortcut"
msgstr "Limpar atalho"

msgid "Click a shortcut and press your keys. Esc cancels recording."
msgstr "Clica num atalho e prime as teclas. Esc cancela a gravação."

msgid "The panel shortcut works globally; preset shortcuts work in the game or panel."
msgstr "O atalho do painel funciona globalmente; os das predefinições funcionam no jogo ou no painel."

msgid "Num0–Num9 are keypad keys. Keep Num Lock on; avoid Shift with keypad digits."
msgstr "Num0–Num9 são teclas do teclado numérico. Mantém Num Lock ativado e evita combiná-las com Shift."

