# Item scanning.
msgid "Item cache"
msgstr "Кэш предметов"

msgid "Migrate presets"
msgstr "Перенести наборы"

msgid "Scan item lists"
msgstr "Сканировать списки предметов"

msgid "Check presets"
msgstr "Проверить наборы"

msgid "Check new lists"
msgstr "Проверить новые списки"

msgid "Refresh saved preset images after a game language change or Stratagem icon update."
msgstr "Обновите изображения в сохранённых наборах после смены языка игры или обновления значков стратагем."

msgid "Requires complete caches from a previous scan of the selected item types, with no changes to available items."
msgstr "Требуются полные кэши выбранных типов предметов, созданные при предыдущем сканировании. Доступные предметы должны остаться прежними."

msgid "Check saved images against the existing cache, then scan new lists."
msgstr "Сопоставьте сохранённые изображения с существующим кэшем, затем отсканируйте новые списки."

msgid "Check the old and new lists, then confirm the migration."
msgstr "Сопоставьте старые и новые списки, затем подтвердите перенос."

msgid "{} saved slots across {} presets were located in the existing cache."
msgstr "В существующем кэше найдено сохранённых элементов: {}; наборов: {}."

msgid "No saved slots were found in the existing cache."
msgstr "Сохранённые элементы не найдены в существующем кэше."

msgid "Scan new lists"
msgstr "Сканировать новые списки"

msgid "Checking presets…"
msgstr "Проверка наборов…"

msgid "Could not check presets."
msgstr "Не удалось проверить наборы."

msgid "{} saved slots across {} presets can migrate."
msgstr "Можно перенести сохранённые элементы: {}; наборов: {}."

msgid "No saved slots can be migrated."
msgstr "Нет сохранённых элементов для переноса."

msgid "{} saved slots could not be matched."
msgstr "Не удалось сопоставить сохранённые элементы: {}."

msgid "Saved preset"
msgstr "Сохранённый набор"

msgid "Existing cache"
msgstr "Существующий кэш"

msgid "New scan"
msgstr "Новое сканирование"

msgid "Used by {} presets"
msgstr "В {} наборах"

msgid "Matched"
msgstr "Сопоставлено"

msgid "Conflicting matches"
msgstr "Конфликт сопоставлений"

msgid "No correspondence"
msgstr "Нет соответствия"

msgid "{} / {} matched"
msgstr "Сопоставлено {} / {}"

msgid "{} old · {} new"
msgstr "{} прежних · {} новых"

msgid "Only unmatched"
msgstr "Только без соответствия"

msgid "Loading comparison…"
msgstr "Загрузка сравнения…"

msgid "No unmatched items."
msgstr "Нет предметов без соответствия."

msgid "{} saved slots will remain unchanged."
msgstr "Без изменений останутся сохранённые элементы: {}."

msgid "{} slots unchanged"
msgstr "Элементов без изменений: {}"

msgid "Show full list"
msgstr "Показать полный список"

msgid "No saved items in the selected scope."
msgstr "В выбранной области нет сохранённых предметов."

msgid "No items used by presets. Show the full list to view this cache."
msgstr "Нет предметов, используемых в наборах. Покажите полный список, чтобы просмотреть этот кэш."

msgid "Nothing to compare."
msgstr "Нечего сравнивать."

msgid "List structure changed"
msgstr "Структура списка изменилась"

msgid "No previous cache"
msgstr "Нет прежнего кэша"

msgid "Update cache only"
msgstr "Только обновить кэш"

msgid "Migrate and update cache"
msgstr "Перенести и обновить кэш"

msgid "All items"
msgstr "Все предметы"

msgid "Stratagems"
msgstr "Стратагемы"

msgid "Scan"
msgstr "Сканировать"

msgid "Item scan"
msgstr "Сканирование предметов"

msgid "Open the panel to stop scanning."
msgstr "Откройте панель, чтобы остановить сканирование."

msgid "For clearer icons, scan Boosters when none are in use."
msgstr "Чтобы получить более чёткие значки, сканируйте усилители, когда ни один из них не используется."

# Item editing.
msgid "Edit loadout"
msgstr "Изменить комплект"

msgid "Randomize Stratagems & Booster"
msgstr "Выбрать стратагемы и усилитель случайно"

msgid "Offensive"
msgstr "Атакующая"

msgid "Supply"
msgstr "Снабжения"

msgid "Defensive"
msgstr "Защитная"

msgid "Clear"
msgstr "Очистить"

msgid "Loading…"
msgstr "Загрузка…"

msgid "No items available. You can scan this list now. Missing lists are also scanned automatically when you first apply the corresponding item types."
msgstr "Нет доступных предметов. Этот список можно просканировать сейчас. Недостающие списки также сканируются автоматически при первом применении соответствующих типов предметов."

msgid "Quick start"
msgstr "Быстрый старт"

msgid "Set up your loadout in the game, select a preset, then choose “{}”."
msgstr "Подготовьте снаряжение в игре, выберите набор и нажмите «{}»."

msgid "To use it later, select the preset and choose “{}”, or use its shortcut."
msgstr "Чтобы использовать его позже, выберите набор и нажмите «{}» или воспользуйтесь его сочетанием клавиш."

msgid "You can also use “{}” to change items or randomize your loadout. Required lists are scanned automatically when you first apply each item type, or you can scan them in advance."
msgstr "Через «{}» также можно менять предметы или создавать случайный комплект. Нужные списки сканируются автоматически при первом применении каждого типа предметов; их также можно отсканировать заранее."

msgid "Got it"
msgstr "Понятно"

msgid "Save changes"
msgstr "Сохранить изменения"

msgid "Randomize equipment"
msgstr "Выбрать снаряжение случайно"

msgid "Scan all missing lists"
msgstr "Сканировать все недостающие списки"

msgid "Capture from game"
msgstr "Сохранить из игры"

msgid "Apply to game"
msgstr "Применить в игре"

msgid "Scan the required item lists ({}) once to build the cache. This may take a while; the cache is reused when applying presets."
msgstr "При первом использовании нужные списки предметов ({}) будут просканированы и сохранены в кэш. Это может занять время; при последующих применениях сканирование не потребуется."

# Item-list confirmation.
msgid "Build item cache"
msgstr "Создать кэш предметов"

msgid "Build cache and apply"
msgstr "Создать кэш и применить"

msgid "Rescan this list"
msgstr "Пересканировать этот список"

msgid "Scan this list"
msgstr "Сканировать этот список"

msgid "Scan this list from the game. All unsaved edits will be discarded."
msgstr "Отсканировать этот список в игре. Все несохранённые изменения будут потеряны."

msgid "Missing an item?"
msgstr "Нет нужного предмета?"

msgid "Scan missing lists from the game. All unsaved edits will be discarded."
msgstr "Отсканировать недостающие списки в игре. Все несохранённые изменения будут потеряны."

# Tray.
msgid "Exit"
msgstr "Выход"
