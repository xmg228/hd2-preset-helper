msgstr "Автоматически проверять обновления"

# Item scanning.
msgid "Item cache"
msgstr "Кэш предметов"

msgid "All items"
msgstr "Все предметы"

msgid "Stratagems"
msgstr "Стратагемы"

msgid "Scan"
msgstr "Сканировать"

msgid "Item scan"
msgstr "Сканирование предметов"

msgid "Open the panel to stop scanning."
msgstr "Откройте панель, чтобы остановить сканирование."

msgid "For clearer icons, scan Boosters when none are in use."
msgstr "Чтобы получить более чёткие значки, сканируйте усилители, когда ни один из них не используется."

# Item editing.
msgid "Edit loadout"
msgstr "Изменить комплект"

msgid "Randomize Stratagems & Booster"
msgstr "Выбрать стратагемы и усилитель случайно"

msgid "Offensive"
msgstr "Атакующая"

msgid "Supply"
msgstr "Снабжения"

msgid "Defensive"
msgstr "Защитная"

msgid "Clear"
msgstr "Очистить"

msgid "Loading…"
msgstr "Загрузка…"

msgid "No items available. You can scan this list now. Missing lists are also scanned automatically when you first apply the corresponding item types."
msgstr "Нет доступных предметов. Этот список можно просканировать сейчас. Недостающие списки также сканируются автоматически при первом применении соответствующих типов предметов."

msgid "Quick start"
msgstr "Быстрый старт"

msgid "Set up your loadout in the game, select a preset, then choose “{}”."
msgstr "Подготовьте снаряжение в игре, выберите набор и нажмите «{}»."

msgid "To use it later, select the preset and choose “{}”, or use its shortcut."
msgstr "Чтобы использовать его позже, выберите набор и нажмите «{}» или воспользуйтесь его сочетанием клавиш."

msgid "You can also use “{}” to change items or randomize your loadout. Required lists are scanned automatically when you first apply each item type, or you can scan them in advance."
msgstr "Через «{}» также можно менять предметы или создавать случайный комплект. Нужные списки сканируются автоматически при первом применении каждого типа предметов; их также можно отсканировать заранее."

msgid "Got it"
msgstr "Понятно"

msgid "Save changes"
msgstr "Сохранить изменения"

msgid "Randomize equipment"
msgstr "Выбрать снаряжение случайно"

msgid "Scan all missing lists"
msgstr "Сканировать все недостающие списки"

msgid "Capture from game"
msgstr "Сохранить из игры"

msgid "Apply to game"
msgstr "Применить в игре"

msgid "Scan the required item lists ({}) once to build the cache. This may take a while; the cache is reused when applying presets."
msgstr "При первом использовании нужные списки предметов ({}) будут просканированы и сохранены в кэш. Это может занять время; при последующих применениях сканирование не потребуется."

# Item-list confirmation.
msgid "Build item cache"
msgstr "Создать кэш предметов"

msgid "Build cache and apply"
msgstr "Создать кэш и применить"

msgid "Rescan this list"
msgstr "Пересканировать этот список"

msgid "Scan this list"
msgstr "Сканировать этот список"

msgid "Scan this list from the game. All unsaved edits will be discarded."
msgstr "Отсканировать этот список в игре. Все несохранённые изменения будут потеряны."

msgid "Missing an item?"
msgstr "Нет нужного предмета?"

msgid "Scan missing lists from the game. All unsaved edits will be discarded."
msgstr "Отсканировать недостающие списки в игре. Все несохранённые изменения будут потеряны."

# Tray.
msgid "Exit"
msgstr "Выход"
