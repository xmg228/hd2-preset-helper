# Shortcut settings.
msgid "Open panel"
msgstr "Открыть панель"

msgid "Press keys…"
msgstr "Нажмите клавиши…"

msgid "Unassigned"
msgstr "Не назначено"

msgid "Set shortcut"
msgstr "Назначить сочетание клавиш"

msgid "Clear shortcut"
msgstr "Сбросить сочетание клавиш"

msgid "Click a shortcut to record. Esc cancels."
msgstr "Нажмите на сочетание клавиш для записи. Esc — отмена."

msgid "The panel shortcut works globally; preset shortcuts work in the game or panel."
msgstr "Сочетание клавиш панели работает везде; сочетания наборов — только в игре или на панели."

msgid "Num0–Num9 are keypad keys. Keep Num Lock on; avoid Shift with keypad digits."
msgstr "Num0–Num9 — клавиши цифрового блока. Держите Num Lock включённым и не сочетайте эти цифры с Shift."

# Dialogs and fixed error controls.
msgid "Delete preset?"
msgstr "Удалить набор?"

msgid "Its saved content and shortcut will be deleted. This cannot be undone."
msgstr "Его сохранённое содержимое и сочетание клавиш будут удалены. Это действие нельзя отменить."

msgid "Don't ask again this session"
msgstr "Больше не спрашивать в этом сеансе"

msgid "Cancel"
msgstr "Отмена"

msgid "Delete"
msgstr "Удалить"

msgid "Copied"
msgstr "Скопировано"

msgid "Copy details"
msgstr "Копировать подробности"

msgid "Dismiss last failure"
msgstr "Закрыть последнюю ошибку"

