# Item scanning.
msgid "Item cache"
msgstr "Cache degli oggetti"

msgid "Migrate presets"
msgstr "Migra i preset"

msgid "Scan item lists"
msgstr "Scansiona gli elenchi di oggetti"

msgid "Check presets"
msgstr "Verifica i preset"

msgid "Check new lists"
msgstr "Verifica i nuovi elenchi"

msgid "Refresh saved preset images after a game language change or Stratagem icon update."
msgstr "Aggiorna le immagini dei preset salvati dopo aver cambiato la lingua del gioco o dopo un aggiornamento delle icone degli stratagemmi."

msgid "Requires complete caches from a previous scan of the selected item types, with no changes to available items."
msgstr "Richiede cache complete ottenute da una scansione precedente dei tipi di oggetti selezionati, senza modifiche agli oggetti disponibili."

msgid "Check saved images against the existing cache, then scan new lists."
msgstr "Confronta le immagini salvate con la cache esistente, poi scansiona i nuovi elenchi."

msgid "Check the old and new lists, then confirm the migration."
msgstr "Confronta i vecchi e i nuovi elenchi, poi conferma la migrazione."

msgid "{} saved slots across {} presets were located in the existing cache."
msgstr "Trovate {} voci salvate di {} preset nella cache esistente."

msgid "No saved slots were found in the existing cache."
msgstr "Nessuna voce salvata trovata nella cache esistente."

msgid "Scan new lists"
msgstr "Scansiona i nuovi elenchi"

msgid "Checking presets…"
msgstr "Verifica dei preset…"

msgid "Could not check presets."
msgstr "Impossibile verificare i preset."

msgid "{} saved slots across {} presets can migrate."
msgstr "È possibile migrare {} voci salvate di {} preset."

msgid "No saved slots can be migrated."
msgstr "Nessuna voce salvata può essere migrata."

msgid "{} saved slots could not be matched."
msgstr "Non è stato possibile identificare {} voci salvate."

