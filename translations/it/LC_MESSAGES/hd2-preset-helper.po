# General settings.
msgid "General"
msgstr "Generale"

msgid "Shortcuts"
msgstr "Scorciatoie"

msgid "Apply Stratagems in saved order"
msgstr "Applica gli stratagemmi nell'ordine salvato"

msgid "Only when all four slots start empty."
msgstr "Solo se tutti e quattro gli slot sono vuoti all'inizio."

msgid "Auto ready up"
msgstr "Pronto in automatico"

msgid "Ready up after successfully applying a Booster."
msgstr "Imposta automaticamente lo stato pronto dopo aver applicato un potenziamento."

msgid "Save fallback Booster when taken"
msgstr "Salva un potenziamento di riserva se lo usa un compagno"

msgid "Wait for your selection, then save it as a fallback."
msgstr "Attende la tua selezione, poi la salva come riserva."

msgid "Display"
msgstr "Schermo"

msgid "Follow game (automatic)"
msgstr "Segui il gioco (automatico)"

msgid "Saved display (unavailable)"
msgstr "Schermo salvato (non disponibile)"

