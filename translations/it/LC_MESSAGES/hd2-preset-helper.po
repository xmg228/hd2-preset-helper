msgstr "Salva"

# Shortcut settings.
msgid "Open panel"
msgstr "Apri pannello"

msgid "Press keys…"
msgstr "Premi i tasti…"

msgid "Unassigned"
msgstr "Non assegnata"

msgid "Clear shortcut"
msgstr "Cancella scorciatoia"

msgid "Click a shortcut and press your keys. Esc cancels recording."
msgstr "Fai clic su una scorciatoia e premi i tasti desiderati. Esc annulla la registrazione."

msgid "The panel shortcut works globally; preset shortcuts work in the game or panel."
msgstr "La scorciatoia del pannello è globale; quelle dei preset funzionano nel gioco o nel pannello."

msgid "Num0–Num9 are keypad keys. Keep Num Lock on; avoid Shift with keypad digits."
msgstr "Num0–Num9 sono tasti del tastierino numerico. Tieni Num Lock attivo; evita Shift con le cifre del tastierino."

# Dialogs and fixed error controls.
msgid "Delete preset?"
msgstr "Eliminare il preset?"

msgid "Its saved content and shortcut will be deleted. This cannot be undone."
msgstr "Il contenuto salvato e la scorciatoia verranno eliminati. L'operazione è irreversibile."

msgid "Cancel"
msgstr "Annulla"

msgid "Delete"
msgstr "Elimina"

msgid "Copied"
msgstr "Copiato"

msgid "Copy details"
msgstr "Copia dettagli"

msgid "Dismiss last failure"
msgstr "Chiudi l'ultimo messaggio di errore"

