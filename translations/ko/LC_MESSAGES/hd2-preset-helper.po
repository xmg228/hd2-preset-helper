# Item scanning.
msgid "Item cache"
msgstr "아이템 캐시"

msgid "Migrate presets"
msgstr "프리셋 이전"

msgid "Scan item lists"
msgstr "아이템 목록 스캔"

msgid "Check presets"
msgstr "프리셋 확인"

msgid "Check new lists"
msgstr "새 목록 확인"

msgid "Refresh saved preset images after a game language change or Stratagem icon update."
msgstr "게임 언어 변경이나 스트라타젬 아이콘 업데이트 후 저장된 프리셋 이미지를 갱신합니다."

msgid "Requires complete caches from a previous scan of the selected item types, with no changes to available items."
msgstr "선택한 아이템 유형을 이전에 스캔해 만든 완전한 캐시가 필요하며, 사용 가능한 아이템이 바뀌지 않아야 합니다."

msgid "Check saved images against the existing cache, then scan new lists."
msgstr "저장된 이미지와 기존 캐시의 대응을 확인한 뒤 새 목록을 스캔하세요."

msgid "Check the old and new lists, then confirm the migration."
msgstr "기존 목록과 새 목록의 대응을 확인한 뒤 이전을 확정하세요."

msgid "{} saved slots across {} presets were located in the existing cache."
msgstr "저장된 항목 {}개(프리셋 {}개)를 기존 캐시에서 찾았습니다."

msgid "No saved slots were found in the existing cache."
msgstr "기존 캐시에서 저장된 항목을 찾지 못했습니다."

msgid "Scan new lists"
msgstr "새 목록 스캔"

msgid "Checking presets…"
msgstr "프리셋 확인 중…"

msgid "Could not check presets."
msgstr "프리셋을 확인하지 못했습니다."

msgid "{} saved slots across {} presets can migrate."
msgstr "저장된 항목 {}개(프리셋 {}개)를 이전할 수 있습니다."

msgid "No saved slots can be migrated."
msgstr "이전할 수 있는 저장된 항목이 없습니다."

msgid "{} saved slots could not be matched."
msgstr "저장된 항목 {}개를 대응시키지 못했습니다."

msgid "Saved preset"
msgstr "저장된 프리셋"

msgid "Existing cache"
msgstr "기존 캐시"

msgid "New scan"
msgstr "새 스캔 결과"

msgid "Used by {} presets"
msgstr "프리셋 {}개에서 사용"

msgid "Matched"
msgstr "대응 완료"

msgid "Conflicting matches"
msgstr "대응 충돌"

msgid "No correspondence"
msgstr "대응 없음"

msgid "{} / {} matched"
msgstr "{} / {} 대응 완료"

msgid "{} old · {} new"
msgstr "기존 {} · 신규 {}"

msgid "Only unmatched"
msgstr "미대응 항목만"

msgid "Loading comparison…"
msgstr "비교 불러오는 중…"

msgid "No unmatched items."
msgstr "미대응 아이템이 없습니다."

msgid "{} saved slots will remain unchanged."
msgstr "저장된 항목 {}개는 그대로 유지됩니다."

msgid "{} slots unchanged"
msgstr "항목 {}개 그대로 유지"

msgid "Show full list"
msgstr "전체 목록 표시"

msgid "No saved items in the selected scope."
msgstr "선택한 범위에 저장된 아이템이 없습니다."

msgid "No items used by presets. Show the full list to view this cache."
msgstr "프리셋에서 사용하는 아이템이 없습니다. 전체 목록을 표시하면 이 캐시를 볼 수 있습니다."

msgid "Nothing to compare."
msgstr "비교할 내용이 없습니다."

msgid "List structure changed"
msgstr "목록 구조가 변경됨"

msgid "No previous cache"
msgstr "이전 캐시 없음"

msgid "Update cache only"
msgstr "캐시만 업데이트"

msgid "Migrate and update cache"
msgstr "이전 및 캐시 업데이트"

msgid "All items"
msgstr "모든 아이템"

msgid "Stratagems"
msgstr "스트라타젬"

msgid "Scan"
msgstr "스캔"

msgid "Item scan"
msgstr "아이템 스캔"

msgid "Open the panel to stop scanning."
msgstr "패널을 열면 스캔이 중지됩니다."

msgid "For clearer icons, scan Boosters when none are in use."
msgstr "더 선명한 아이콘을 얻으려면 부스터가 사용 중이지 않을 때 스캔하세요."

# Item editing.
msgid "Edit loadout"
msgstr "장비 구성 편집"

msgid "Randomize Stratagems & Booster"
msgstr "스트라타젬과 부스터 무작위 선택"

msgid "Offensive"
msgstr "공격"

msgid "Supply"
msgstr "보급"

msgid "Defensive"
msgstr "방어"

msgid "Clear"
msgstr "지우기"

msgid "Loading…"
msgstr "불러오는 중…"

msgid "No items available. You can scan this list now. Missing lists are also scanned automatically when you first apply the corresponding item types."
msgstr "선택할 수 있는 아이템이 없습니다. 지금 이 목록을 스캔할 수 있습니다. 누락된 목록은 해당 종류의 아이템을 처음 적용할 때도 자동으로 스캔됩니다."

msgid "Quick start"
msgstr "빠른 시작"

msgid "Set up your loadout in the game, select a preset, then choose “{}”."
msgstr "게임에서 장비를 구성하고 프리셋을 선택한 뒤 ‘{}’ 버튼을 누르세요."

msgid "To use it later, select the preset and choose “{}”, or use its shortcut."
msgstr "나중에 사용하려면 프리셋을 선택하고 ‘{}’ 버튼을 누르거나 해당 단축키를 사용하세요."

msgid "You can also use “{}” to change items or randomize your loadout. Required lists are scanned automatically when you first apply each item type, or you can scan them in advance."
msgstr "‘{}’ 기능으로 아이템을 바꾸거나 장비를 무작위로 구성할 수도 있습니다. 필요한 목록은 각 종류의 아이템을 처음 적용할 때 자동으로 스캔되며, 미리 스캔할 수도 있습니다."

msgid "Got it"
msgstr "확인"

msgid "Save changes"
msgstr "변경 사항 저장"

msgid "Randomize equipment"
msgstr "장비 무작위 선택"

msgid "Scan all missing lists"
msgstr "누락된 모든 목록 스캔"

msgid "Capture from game"
msgstr "게임에서 저장"

msgid "Apply to game"
msgstr "게임에 적용"

msgid "Scan the required item lists ({}) once to build the cache. This may take a while; the cache is reused when applying presets."
msgstr "처음에는 아이템 목록 {}개를 스캔하여 캐시를 생성하므로 시간이 걸릴 수 있습니다. 이후에는 캐시를 재사용하므로 매번 스캔할 필요가 없습니다."

# Item-list confirmation.
msgid "Build item cache"
msgstr "아이템 캐시 생성"

msgid "Build cache and apply"
msgstr "캐시 생성 후 적용"

msgid "Rescan this list"
msgstr "이 목록 다시 스캔"

msgid "Scan this list"
msgstr "이 목록 스캔"

msgid "Scan this list from the game. All unsaved edits will be discarded."
msgstr "게임에서 이 목록을 스캔합니다. 저장하지 않은 모든 변경 사항은 사라집니다."

msgid "Missing an item?"
msgstr "아이템이 없나요?"

msgid "Scan missing lists from the game. All unsaved edits will be discarded."
msgstr "게임에서 누락된 목록을 스캔합니다. 저장하지 않은 모든 변경 사항은 사라집니다."

# Tray.
msgid "Exit"
msgstr "종료"
