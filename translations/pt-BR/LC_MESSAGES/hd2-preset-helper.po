# Item scanning.
msgid "Item cache"
msgstr "Cache de itens"

msgid "All items"
msgstr "Todos os itens"

msgid "Stratagems"
msgstr "Estratégias"

msgid "Scan"
msgstr "Escanear"

msgid "Item scan"
msgstr "Varredura de itens"

msgid "Open the panel to stop scanning."
msgstr "Abra o painel para interromper a varredura."

msgid "For clearer icons, scan Boosters when none are in use."
msgstr "Para obter ícones mais nítidos, escaneie os reforçadores quando nenhum estiver em uso."

# Item editing.
msgid "Edit loadout"
msgstr "Editar configuração"

msgid "Randomize Stratagems & Booster"
msgstr "Sortear estratégias e reforçador"

msgid "Offensive"
msgstr "Ofensiva"

msgid "Supply"
msgstr "Suprimento"

msgid "Defensive"
msgstr "Defensiva"

msgid "Clear"
msgstr "Limpar"

msgid "Loading…"
msgstr "Carregando…"

msgid "No items available. You can scan this list now. Missing lists are also scanned automatically when you first apply the corresponding item types."
msgstr "Nenhum item disponível. Você pode escanear esta lista agora. As listas ausentes também serão escaneadas automaticamente na primeira aplicação dos tipos de item correspondentes."

msgid "Quick start"
msgstr "Primeiros passos"

msgid "Set up your loadout in the game, select a preset, then choose “{}”."
msgstr "Monte seu equipamento no jogo, selecione uma predefinição e escolha “{}”."

msgid "To use it later, select the preset and choose “{}”, or use its shortcut."
msgstr "Para usá-la depois, selecione a predefinição e escolha “{}”, ou use seu atalho."

msgid "You can also use “{}” to change items or randomize your loadout. Required lists are scanned automatically when you first apply each item type, or you can scan them in advance."
msgstr "Você também pode usar “{}” para trocar itens ou criar uma configuração aleatória. As listas necessárias são escaneadas automaticamente na primeira vez que você aplica cada tipo de item, ou podem ser escaneadas antes."

msgid "Got it"
msgstr "Entendi"

msgid "Save changes"
msgstr "Salvar alterações"

msgid "Randomize equipment"
msgstr "Sortear equipamento"

msgid "Scan all missing lists"
msgstr "Escanear todas as listas ausentes"

msgid "Capture from game"
msgstr "Salvar do jogo"

msgid "Apply to game"
msgstr "Aplicar no jogo"

msgid "Scan the required item lists ({}) once to build the cache. This may take a while; the cache is reused when applying presets."
msgstr "No primeiro uso, é preciso analisar {} listas de itens e criar o cache, o que pode demorar. As próximas aplicações reutilizarão o cache, sem analisar a cada vez."

# Item-list confirmation.
msgid "Build item cache"
msgstr "Criar cache de itens"

