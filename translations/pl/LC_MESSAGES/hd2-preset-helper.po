msgstr "Nieprzypisany"

msgid "Set shortcut"
msgstr "Ustaw skrót"

msgid "Clear shortcut"
msgstr "Wyczyść skrót"

msgid "Click a shortcut to record. Esc cancels."
msgstr "Kliknij skrót, aby go ustawić. Esc anuluje."

msgid "The panel shortcut works globally; preset shortcuts work in the game or panel."
msgstr "Skrót panelu działa globalnie; skróty zestawów działają w grze lub panelu."

msgid "Num0–Num9 are keypad keys. Keep Num Lock on; avoid Shift with keypad digits."
msgstr "Num0–Num9 to klawisze bloku numerycznego. Włącz Num Lock; unikaj Shift z cyframi bloku numerycznego."

# Dialogs and fixed error controls.
msgid "Delete preset?"
msgstr "Usunąć zestaw?"

msgid "Its saved content and shortcut will be deleted. This cannot be undone."
msgstr "Jego zapisana zawartość i skrót zostaną usunięte. Tej operacji nie można cofnąć."

msgid "Don't ask again this session"
msgstr "Nie pytaj ponownie w tej sesji"

msgid "Cancel"
msgstr "Anuluj"

msgid "Delete"
msgstr "Usuń"

msgid "Copied"
msgstr "Skopiowano"

msgid "Copy details"
msgstr "Kopiuj szczegóły"

msgid "Dismiss last failure"
msgstr "Zamknij ostatni komunikat o błędzie"

