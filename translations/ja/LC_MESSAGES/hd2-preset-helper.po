msgid "View available update"
msgstr "利用可能な更新を表示"

msgid "About"
msgstr "このアプリについて"

msgid "Back"
msgstr "戻る"

msgid "Open-source licenses"
msgstr "オープンソースライセンス"

msgid "Version {}"
msgstr "バージョン {}"

msgid "Check for updates"
msgstr "更新を確認"

msgid "Release notes"
msgstr "更新内容"

msgid "Download update"
msgstr "更新をダウンロード"

msgid "Ready to restart"
msgstr "再起動の準備ができました"

msgid "Restart to update"
msgstr "更新して再起動"

msgid "Checking for updates…"
msgstr "更新を確認中…"

msgid "Up to date"
msgstr "最新バージョン"

msgid "Downloading update…"
msgstr "更新をダウンロード中…"

msgid "Installing update…"
msgstr "更新をインストール中…"

msgid "Restarting…"
msgstr "再起動中…"

msgid "Install releases manually in this build."
msgstr "このビルドでは手動で更新してください。"

msgid "Check for updates automatically"
msgstr "更新を自動的に確認"

# Item scanning.
msgid "Item cache"
msgstr "アイテムキャッシュ"

msgid "All items"
msgstr "すべてのアイテム"

msgid "Stratagems"
msgstr "戦略支援"

msgid "Scan"
msgstr "スキャン"

msgid "Item scan"
msgstr "アイテムのスキャン"

msgid "Open the panel to stop scanning."
msgstr "パネルを開くとスキャンを停止します。"

msgid "For clearer icons, scan Boosters when none are in use."
msgstr "鮮明なアイコンを取得するには、ブースターが使用されていない状態でスキャンしてください。"

# Item editing.
msgid "Edit loadout"
msgstr "装備構成を編集"

msgid "Randomize Stratagems & Booster"
msgstr "ストラタジェムとブースターをランダム選択"

msgid "Offensive"
msgstr "攻撃タイプ"

msgid "Supply"
msgstr "補給タイプ"

msgid "Defensive"
msgstr "防衛タイプ"

msgid "Clear"
msgstr "クリア"

msgid "Loading…"
msgstr "読み込み中…"

msgid "No items available. You can scan this list now. Missing lists are also scanned automatically when you first apply the corresponding item types."
msgstr "選択できるアイテムがありません。今すぐこの一覧をスキャンできます。未取得の一覧は、対応する種類のアイテムを初めて適用するときにも自動でスキャンされます。"

msgid "Quick start"
msgstr "クイックスタート"

msgid "Set up your loadout in the game, select a preset, then choose “{}”."
msgstr "ゲーム内で装備を整え、プリセットを選んで「{}」を押します。"

msgid "To use it later, select the preset and choose “{}”, or use its shortcut."
msgstr "後で使うときは、プリセットを選んで「{}」を押すか、ショートカットキーを使います。"

msgid "You can also use “{}” to change items or randomize your loadout. Required lists are scanned automatically when you first apply each item type, or you can scan them in advance."
msgstr "「{}」ではアイテムの変更やランダムな装備構成の作成もできます。必要なリストは各種類のアイテムを初めて適用するときに自動でスキャンされます。事前にスキャンすることもできます。"

msgid "Got it"
msgstr "わかりました"

msgid "Save changes"
msgstr "変更を保存"

msgid "Randomize equipment"
msgstr "装備をランダム選択"

msgid "Scan all missing lists"
msgstr "未取得の一覧をすべてスキャン"

msgid "Capture from game"
msgstr "ゲームから保存"

msgid "Apply to game"
msgstr "ゲームに適用"

msgid "Scan the required item lists ({}) once to build the cache. This may take a while; the cache is reused when applying presets."
msgstr "初回は{}種類のアイテム一覧をスキャンしてキャッシュを作成するため、時間がかかる場合があります。次回以降はキャッシュを再利用し、毎回のスキャンは不要です。"

# Item-list confirmation.
msgid "Build item cache"
msgstr "アイテムキャッシュを作成"

msgid "Build cache and apply"
msgstr "キャッシュを作成して適用"

msgid "Rescan this list"
msgstr "この一覧を再スキャン"

msgid "Scan this list"
msgstr "この一覧をスキャン"

msgid "Scan this list from the game. All unsaved edits will be discarded."
msgstr "ゲーム内のこの一覧をスキャンします。未保存の変更はすべて破棄されます。"

msgid "Missing an item?"
msgstr "アイテムが見つかりませんか？"

msgid "Scan missing lists from the game. All unsaved edits will be discarded."
msgstr "ゲーム内の未取得の一覧をスキャンします。未保存の変更はすべて破棄されます。"

# Tray.
msgid "Exit"
msgstr "終了"
