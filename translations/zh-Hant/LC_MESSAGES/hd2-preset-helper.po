msgstr "備用強化套件"

msgid "Helmet"
msgstr "頭盔"

msgid "Armor"
msgstr "裝甲"

msgid "Cape"
msgstr "披肩"

msgid "Primary"
msgstr "主武器"

msgid "Secondary"
msgstr "副武器"

msgid "Throwable"
msgstr "投擲物"

msgid "Settings"
msgstr "設定"

msgid "Hide panel"
msgstr "隱藏面板"

msgid "Preview unavailable"
msgstr "無法預覽"

msgid "Not saved"
msgstr "尚未儲存"

msgid "Loading previews…"
msgstr "正在載入預覽…"

msgid "+ New preset"
msgstr "+ 新增預設"

msgid "Select a preset"
msgstr "選擇預設"

msgid "No presets"
msgstr "尚無預設"

msgid "Cut"
msgstr "剪下"

msgid "Copy"
msgstr "複製"

msgid "Paste"
msgstr "貼上"

