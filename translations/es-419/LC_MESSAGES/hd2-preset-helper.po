# General settings.
msgid "General"
msgstr "General"

msgid "Shortcuts"
msgstr "Atajos"

msgid "Apply Stratagems in saved order"
msgstr "Aplicar estratagemas en el orden guardado"

msgid "Only when all four slots start empty."
msgstr "Solo si los cuatro espacios están vacíos al comenzar."

msgid "Auto ready up"
msgstr "Listo automáticamente"

msgid "Ready up after successfully applying a Booster."
msgstr "Activa «Listo» tras aplicar un potenciador con éxito."

msgid "Save fallback Booster when taken"
msgstr "Guardar alternativa si otro usa el potenciador"

msgid "Wait for your selection, then save it as a fallback."
msgstr "Espera tu selección y la guarda como alternativa."

msgid "Display"
msgstr "Pantalla"

