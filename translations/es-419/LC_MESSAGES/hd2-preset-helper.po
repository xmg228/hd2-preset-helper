# Item scanning.
msgid "Item cache"
msgstr "Caché de objetos"

msgid "All items"
msgstr "Todos los objetos"

msgid "Stratagems"
msgstr "Estratagemas"

msgid "Scan"
msgstr "Escanear"

msgid "Item scan"
msgstr "Escaneo de objetos"

msgid "Open the panel to stop scanning."
msgstr "Abre el panel para detener el escaneo."

msgid "For clearer icons, scan Boosters when none are in use."
msgstr "Para obtener íconos más nítidos, escanea los potenciadores cuando ninguno esté en uso."

# Item editing.
msgid "Edit loadout"
msgstr "Editar equipamiento"

msgid "Randomize Stratagems & Booster"
msgstr "Elegir estratagemas y potenciador al azar"

msgid "Offensive"
msgstr "Ofensivas"

msgid "Supply"
msgstr "Suministros"

msgid "Defensive"
msgstr "Defensivas"

msgid "Clear"
msgstr "Quitar"

msgid "Loading…"
msgstr "Cargando…"

msgid "No items available. You can scan this list now. Missing lists are also scanned automatically when you first apply the corresponding item types."
msgstr "No hay objetos disponibles. Puedes escanear esta lista ahora. Las listas que falten también se escanearán automáticamente la primera vez que apliques los tipos de objeto correspondientes."

msgid "Quick start"
msgstr "Inicio rápido"

msgid "Set up your loadout in the game, select a preset, then choose “{}”."
msgstr "Configura tu equipamiento en el juego, selecciona un preajuste y elige «{}»."

msgid "To use it later, select the preset and choose “{}”, or use its shortcut."
msgstr "Para usarlo después, selecciona el preajuste y elige «{}», o usa su atajo de teclado."

msgid "You can also use “{}” to change items or randomize your loadout. Required lists are scanned automatically when you first apply each item type, or you can scan them in advance."
msgstr "También puedes usar «{}» para cambiar objetos o generar un equipamiento aleatorio. Las listas necesarias se escanean automáticamente la primera vez que aplicas cada tipo de objeto, o puedes escanearlas de antemano."

msgid "Got it"
msgstr "Entendido"

msgid "Save changes"
msgstr "Guardar cambios"

msgid "Randomize equipment"
msgstr "Elegir equipamiento al azar"

msgid "Scan all missing lists"
msgstr "Escanear todas las listas faltantes"

msgid "Capture from game"
msgstr "Guardar desde el juego"

msgid "Apply to game"
msgstr "Aplicar al juego"

msgid "Scan the required item lists ({}) once to build the cache. This may take a while; the cache is reused when applying presets."
msgstr "El primer uso requiere analizar {} listas de objetos y crear una caché, lo que puede tardar. Las próximas aplicaciones reutilizarán la caché, sin analizar cada vez."

# Item-list confirmation.
msgid "Build item cache"
msgstr "Crear caché de objetos"

msgid "Build cache and apply"
msgstr "Crear caché y aplicar"

msgid "Rescan this list"
msgstr "Volver a escanear esta lista"

msgid "Scan this list"
msgstr "Escanear esta lista"

msgid "Scan this list from the game. All unsaved edits will be discarded."
msgstr "Se escaneará esta lista en el juego. Se descartarán todos los cambios sin guardar."

msgid "Missing an item?"
msgstr "¿Falta un objeto?"

msgid "Scan missing lists from the game. All unsaved edits will be discarded."
msgstr "Se escanearán las listas faltantes en el juego. Se descartarán todos los cambios sin guardar."

# Tray.
msgid "Exit"
msgstr "Salir"
