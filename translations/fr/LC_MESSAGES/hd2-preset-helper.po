# Item scanning.
msgid "Item cache"
msgstr "Cache des objets"

msgid "Migrate presets"
msgstr "Migrer les préréglages"

msgid "Scan item lists"
msgstr "Analyser les listes d'objets"

msgid "Check presets"
msgstr "Vérifier les préréglages"

msgid "Check new lists"
msgstr "Vérifier les nouvelles listes"

msgid "Refresh saved preset images after a game language change or Stratagem icon update."
msgstr "Actualisez les images des préréglages enregistrés après un changement de langue du jeu ou une mise à jour des icônes de stratagèmes."

msgid "Requires complete caches from a previous scan of the selected item types, with no changes to available items."
msgstr "Nécessite des caches complets issus d'une analyse précédente des types d'objets sélectionnés, sans changement des objets disponibles."

msgid "Check saved images against the existing cache, then scan new lists."
msgstr "Comparez les images enregistrées au cache existant, puis analysez les nouvelles listes."

msgid "Check the old and new lists, then confirm the migration."
msgstr "Comparez les anciennes et les nouvelles listes, puis confirmez la migration."

msgid "{} saved slots across {} presets were located in the existing cache."
msgstr "{} éléments enregistrés dans {} préréglages ont été retrouvés dans le cache existant."

msgid "No saved slots were found in the existing cache."
msgstr "Aucun élément enregistré n'a été trouvé dans le cache existant."

