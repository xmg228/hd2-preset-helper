msgid "Build item cache"
msgstr "Créer le cache des objets"

msgid "Build cache and apply"
msgstr "Créer le cache et appliquer"

msgid "Rescan this list"
msgstr "Analyser à nouveau cette liste"

msgid "Scan this list"
msgstr "Analyser cette liste"

msgid "Scan this list from the game. All unsaved edits will be discarded."
msgstr "Cette liste sera analysée dans le jeu. Toutes les modifications non enregistrées seront perdues."

msgid "Missing an item?"
msgstr "Un objet manque ?"

msgid "Scan missing lists from the game. All unsaved edits will be discarded."
msgstr "Les listes manquantes seront analysées dans le jeu. Toutes les modifications non enregistrées seront perdues."

