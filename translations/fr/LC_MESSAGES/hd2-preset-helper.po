msgstr "Enregistrer"

# Shortcut settings.
msgid "Open panel"
msgstr "Ouvrir le panneau"

msgid "Press keys…"
msgstr "Appuyez sur les touches…"

msgid "Unassigned"
msgstr "Non attribué"

msgid "Clear shortcut"
msgstr "Effacer le raccourci"

msgid "Click a shortcut and press your keys. Esc cancels recording."
msgstr "Cliquez sur un raccourci et appuyez sur les touches souhaitées. Esc annule la saisie."

msgid "The panel shortcut works globally; preset shortcuts work in the game or panel."
msgstr "Le raccourci du panneau fonctionne partout ; ceux des préréglages fonctionnent dans le jeu ou le panneau."

msgid "Num0–Num9 are keypad keys. Keep Num Lock on; avoid Shift with keypad digits."
msgstr "Num0–Num9 sont les touches du pavé numérique. Gardez Num Lock activé ; évitez Shift avec les chiffres du pavé numérique."

# Dialogs and fixed error controls.
msgid "Delete preset?"
msgstr "Supprimer le préréglage ?"

msgid "Its saved content and shortcut will be deleted. This cannot be undone."
msgstr "Son contenu enregistré et son raccourci seront supprimés. Cette action est irréversible."

msgid "Cancel"
msgstr "Annuler"

msgid "Delete"
msgstr "Supprimer"

msgid "Copied"
msgstr "Copié"

msgid "Copy details"
msgstr "Copier les détails"

msgid "Dismiss last failure"
msgstr "Fermer le dernier message d'erreur"

