msgstr "Nur nicht zugeordnete"

msgid "Loading comparison…"
msgstr "Vergleich wird geladen…"

msgid "No unmatched items."
msgstr "Keine nicht zugeordneten Gegenstände."

msgid "{} saved slots will remain unchanged."
msgstr "{} gespeicherte Einträge bleiben unverändert."

msgid "{} slots unchanged"
msgstr "{} Einträge unverändert"

msgid "Show full list"
msgstr "Vollständige Liste anzeigen"

