# Item scanning.
msgid "Item cache"
msgstr "Gegenstands-Cache"

msgid "Migrate presets"
msgstr "Voreinstellungen migrieren"

msgid "Scan item lists"
msgstr "Gegenstandslisten scannen"

msgid "Check presets"
msgstr "Voreinstellungen prüfen"

msgid "Check new lists"
msgstr "Neue Listen prüfen"

msgid "Refresh saved preset images after a game language change or Stratagem icon update."
msgstr "Bilder gespeicherter Voreinstellungen nach einem Wechsel der Spielsprache oder einer Aktualisierung der Taktikausrüstungs-Symbole erneuern."

msgid "Requires complete caches from a previous scan of the selected item types, with no changes to available items."
msgstr "Erfordert vollständige Caches aus einem früheren Scan der ausgewählten Gegenstandstypen. Die verfügbaren Gegenstände müssen unverändert sein."

msgid "Check saved images against the existing cache, then scan new lists."
msgstr "Gespeicherte Bilder mit dem bisherigen Cache vergleichen, dann neue Listen scannen."

msgid "Check the old and new lists, then confirm the migration."
msgstr "Alte und neue Listen vergleichen, dann die Migration bestätigen."

msgid "{} saved slots across {} presets were located in the existing cache."
msgstr "{} gespeicherte Einträge aus {} Voreinstellungen wurden im bisherigen Cache gefunden."

msgid "No saved slots were found in the existing cache."
msgstr "Keine gespeicherten Einträge wurden im bisherigen Cache gefunden."

msgid "Scan new lists"
msgstr "Neue Listen scannen"

msgid "Checking presets…"
msgstr "Voreinstellungen werden geprüft…"

msgid "Could not check presets."
msgstr "Voreinstellungen konnten nicht geprüft werden."

msgid "{} saved slots across {} presets can migrate."
msgstr "{} gespeicherte Einträge aus {} Voreinstellungen können migriert werden."

msgid "No saved slots can be migrated."
msgstr "Keine gespeicherten Einträge können migriert werden."

msgid "{} saved slots could not be matched."
msgstr "{} gespeicherte Einträge konnten nicht zugeordnet werden."

